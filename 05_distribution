#!/usr/bin/env bash
set -euo pipefail

# Usage:
# bash classify_rloop_by_endpoint.sh \
#   <rloop_peaks.bed> \
#   <promoter.merged.bed> \
#   <gene_body.merged.bed> \
#   <tts.merged.bed> \
#   <chromsize> \
#   <outprefix> \
#   [end_mode]
#
# end_mode:
#   genome_end  : 不考虑 strand，永远用 BED 第3列 end 作为 peak 终点，默认
#   strand_end  : 如果 peak 第6列为 -，则用 BED 第2列 start 作为转录方向终点；
#                 如果为 + 或没有 strand，则用第3列 end
#
# Example:
# bash classify_rloop_by_endpoint.sh \
#   sample.rloop.bed \
#   anno_bed/promoter_TSS_2000up_500down.merged.bed \
#   anno_bed/gene_body.merged.bed \
#   anno_bed/tts_2000bp.merged.bed \
#   genome.chrom.sizes \
#   sample.rloop.location \
#   genome_end

if [[ $# -lt 6 ]]; then
  echo "Usage: bash $0 <rloop_peaks.bed> <promoter.merged.bed> <gene_body.merged.bed> <tts.merged.bed> <chromsize> <outprefix> [genome_end|strand_end]" >&2
  exit 1
fi

PEAKS="$1"
PROMOTER="$2"
GENE_BODY="$3"
TTS="$4"
CHROMSIZE="$5"
OUTPREFIX="$6"
END_MODE="${7:-genome_end}"

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "[ERROR] missing command: $1" >&2
    exit 1
  }
}

need_cmd awk
need_cmd bedtools

if [[ "$END_MODE" != "genome_end" && "$END_MODE" != "strand_end" ]]; then
  echo "[ERROR] end_mode must be genome_end or strand_end" >&2
  exit 1
fi

for f in "$PEAKS" "$PROMOTER" "$GENE_BODY" "$TTS" "$CHROMSIZE"; do
  if [[ ! -f "$f" ]]; then
    echo "[ERROR] file not found: $f" >&2
    exit 1
  fi
done

TMPDIR="${OUTPREFIX}.tmp"
mkdir -p "$TMPDIR"

echo "[INFO] peaks      = $PEAKS"
echo "[INFO] promoter   = $PROMOTER"
echo "[INFO] gene_body  = $GENE_BODY"
echo "[INFO] tts        = $TTS"
echo "[INFO] chromsize  = $CHROMSIZE"
echo "[INFO] outprefix  = $OUTPREFIX"
echo "[INFO] end_mode   = $END_MODE"

# ------------------------------------------------------------
# 1. Convert each R-loop peak to a 1-bp endpoint BED.
#
# Output columns:
# chr, endpoint_start, endpoint_end, peak_id, score, strand,
# original_peak_start, original_peak_end, original_extra_columns...
# ------------------------------------------------------------
awk -v MODE="$END_MODE" 'BEGIN{FS=OFS="\t"}
FNR==NR {
  keep[$1] = 1
  next
}
$0 !~ /^#/ && NF >= 3 && ($1 in keep) {
  chr = $1
  peak_start = $2
  peak_end = $3

  if (peak_end <= peak_start) next

  id = (NF >= 4 && $4 != "" ? $4 : "peak_" NR)
  score = (NF >= 5 && $5 != "" ? $5 : ".")
  strand = (NF >= 6 && $6 != "" ? $6 : ".")

  if (MODE == "strand_end" && strand == "-") {
    s = peak_start
    e = peak_start + 1
  } else {
    s = peak_end - 1
    e = peak_end
  }

  if (s < 0) s = 0
  if (e <= s) next

  printf "%s\t%d\t%d\t%s\t%s\t%s\t%d\t%d", chr, s, e, id, score, strand, peak_start, peak_end

  for (i = 4; i <= NF; i++) {
    printf "\t%s", $i
  }
  printf "\n"
}' "$CHROMSIZE" "$PEAKS" \
  | bedtools sort -g "$CHROMSIZE" -i - \
  > "$TMPDIR/rloop_endpoint.1bp.bed"

endpoint_n=$(wc -l < "$TMPDIR/rloop_endpoint.1bp.bed")
echo "[INFO] endpoint records retained: $endpoint_n"

# ------------------------------------------------------------
# 2. Classify by endpoint.
#
# Priority:
#   promoter > gene_body > TTS > intergenic
#
# 这样可以避免 promoter 与 gene body 重叠导致重复计数。
# ------------------------------------------------------------

bedtools intersect \
  -u \
  -a "$TMPDIR/rloop_endpoint.1bp.bed" \
  -b "$PROMOTER" \
  > "${OUTPREFIX}.promoter.endpoint.bed"

bedtools intersect \
  -v \
  -a "$TMPDIR/rloop_endpoint.1bp.bed" \
  -b "$PROMOTER" \
  > "$TMPDIR/not_promoter.bed"

bedtools intersect \
  -u \
  -a "$TMPDIR/not_promoter.bed" \
  -b "$GENE_BODY" \
  > "${OUTPREFIX}.gene_body.endpoint.bed"

bedtools intersect \
  -v \
  -a "$TMPDIR/not_promoter.bed" \
  -b "$GENE_BODY" \
  > "$TMPDIR/not_promoter_not_gene_body.bed"

bedtools intersect \
  -u \
  -a "$TMPDIR/not_promoter_not_gene_body.bed" \
  -b "$TTS" \
  > "${OUTPREFIX}.tts.endpoint.bed"

bedtools intersect \
  -v \
  -a "$TMPDIR/not_promoter_not_gene_body.bed" \
  -b "$TTS" \
  > "${OUTPREFIX}.intergenic.endpoint.bed"

# ------------------------------------------------------------
# 3. Merge classified result
# ------------------------------------------------------------
{
  awk 'BEGIN{FS=OFS="\t"}{print "promoter",$0}' "${OUTPREFIX}.promoter.endpoint.bed"
  awk 'BEGIN{FS=OFS="\t"}{print "gene_body",$0}' "${OUTPREFIX}.gene_body.endpoint.bed"
  awk 'BEGIN{FS=OFS="\t"}{print "tts",$0}' "${OUTPREFIX}.tts.endpoint.bed"
  awk 'BEGIN{FS=OFS="\t"}{print "intergenic",$0}' "${OUTPREFIX}.intergenic.endpoint.bed"
} > "${OUTPREFIX}.classified_endpoint.tsv"

# ------------------------------------------------------------
# 4. Summary
# ------------------------------------------------------------
{
  echo -e "class\tcount"
  echo -e "promoter\t$(wc -l < "${OUTPREFIX}.promoter.endpoint.bed")"
  echo -e "gene_body\t$(wc -l < "${OUTPREFIX}.gene_body.endpoint.bed")"
  echo -e "tts\t$(wc -l < "${OUTPREFIX}.tts.endpoint.bed")"
  echo -e "intergenic\t$(wc -l < "${OUTPREFIX}.intergenic.endpoint.bed")"
  echo -e "total\t$(wc -l < "${OUTPREFIX}.classified_endpoint.tsv")"
} > "${OUTPREFIX}.summary.tsv"

echo "[OK] classification finished:"
echo "  ${OUTPREFIX}.promoter.endpoint.bed"
echo "  ${OUTPREFIX}.gene_body.endpoint.bed"
echo "  ${OUTPREFIX}.tts.endpoint.bed"
echo "  ${OUTPREFIX}.intergenic.endpoint.bed"
echo "  ${OUTPREFIX}.classified_endpoint.tsv"
echo "  ${OUTPREFIX}.summary.tsv"

chmod +x classify_rloop_by_endpoint.sh
#运行脚本
RESROOT=/data/mshe/deepRloopPro_data/deepRloop_results_A
ANNROOT=/data/mshe/deepRloopPro_data/annotation_beds_3class
OUTROOT=/data/mshe/deepRloopPro_data/rloop_endpoint_3class
SCRIPT=/data/mshe/deepRloopPro_data/classify_rloop_by_endpoint.sh
LIST=/data/mshe/deepRloopPro_data/annotation_list_gene_feature_only.tsv
END_MODE=strand_end
