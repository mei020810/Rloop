#!/usr/bin/env bash
set -euo pipefail

# Usage:
# bash build_annotation_regions_3class.sh \
#   <annotation.gtf/gff/gff3> \
#   <chromsize> \
#   <outdir> \
#   [promoter_upstream_bp] \
#   [promoter_downstream_bp] \
#   [tts_bp] \
#   [feature_type]
#
# Example:
# bash build_annotation_regions_3class.sh genome.gff chrom.sizes anno_bed 2000 500 2000 gene

if [[ $# -lt 3 ]]; then
  echo "Usage: bash $0 <annotation.gtf/gff/gff3> <chromsize> <outdir> [promoter_upstream_bp] [promoter_downstream_bp] [tts_bp] [feature_type]" >&2
  exit 1
fi

ANNO="$1"
CHROMSIZE="$2"
OUTDIR="$3"
PROMOTER_UP="${4:-2000}"
PROMOTER_DOWN="${5:-500}"
TTS_BP="${6:-2000}"
FEATURE_TYPE="${7:-gene}"

mkdir -p "$OUTDIR"

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "[ERROR] missing command: $1" >&2
    exit 1
  }
}

need_cmd awk
need_cmd bedtools

if [[ ! -f "$ANNO" ]]; then
  echo "[ERROR] annotation file not found: $ANNO" >&2
  exit 1
fi

if [[ ! -f "$CHROMSIZE" ]]; then
  echo "[ERROR] chromsize file not found: $CHROMSIZE" >&2
  exit 1
fi

echo "[INFO] annotation       = $ANNO"
echo "[INFO] chromsize        = $CHROMSIZE"
echo "[INFO] outdir           = $OUTDIR"
echo "[INFO] feature_type     = $FEATURE_TYPE"
echo "[INFO] promoter_up      = $PROMOTER_UP"
echo "[INFO] promoter_down    = $PROMOTER_DOWN"
echo "[INFO] tts_bp           = $TTS_BP"

# ------------------------------------------------------------
# 1. gene body
# GTF/GFF: 1-based closed
# BED:     0-based half-open
# ------------------------------------------------------------
awk -v FT="$FEATURE_TYPE" 'BEGIN{FS=OFS="\t"}
function get_id(attr, id) {
  id = attr
  if (match(attr, /gene_id "[^"]+"/)) {
    id = substr(attr, RSTART + 9, RLENGTH - 10)
  } else if (match(attr, /ID=[^;]+/)) {
    id = substr(attr, RSTART + 3, RLENGTH - 3)
  } else if (match(attr, /Name=[^;]+/)) {
    id = substr(attr, RSTART + 5, RLENGTH - 5)
  }
  gsub(/[[:space:]]+/, "_", id)
  return id
}
FNR==NR {
  keep[$1] = 1
  next
}
$0 !~ /^#/ && $3 == FT && ($1 in keep) {
  s = $4 - 1
  e = $5
  if (s < 0) s = 0
  id = get_id($9)
  if (e > s) print $1, s, e, id, ".", $7
}' "$CHROMSIZE" "$ANNO" \
  | bedtools sort -g "$CHROMSIZE" -i - \
  > "$OUTDIR/gene_body.bed"

gene_n=$(wc -l < "$OUTDIR/gene_body.bed")
if [[ "$gene_n" -eq 0 ]]; then
  echo "[ERROR] no $FEATURE_TYPE features found after filtering by chromsize." >&2
  echo "[HINT] Check whether annotation seqids match chromsize seqids." >&2
  exit 1
fi

cut -f1-3 "$OUTDIR/gene_body.bed" \
  | bedtools sort -g "$CHROMSIZE" -i - \
  | bedtools merge -i - \
  > "$OUTDIR/gene_body.merged.bed"

echo "[INFO] gene body retained: $gene_n"

# ------------------------------------------------------------
# 2. promoter: TSS upstream 2 kb + downstream 500 bp
#
# + strand:
#   TSS = gene start
#   promoter = [TSS - UP, TSS + DOWN)
#
# - strand:
#   TSS = gene end
#   promoter = [TSS - DOWN, TSS + UP)
#
# 注意：这里是 BED 的 0-based half-open 坐标
# ------------------------------------------------------------
awk -v UP="$PROMOTER_UP" -v DOWN="$PROMOTER_DOWN" -v FT="$FEATURE_TYPE" 'BEGIN{FS=OFS="\t"}
function get_id(attr, id) {
  id = attr
  if (match(attr, /gene_id "[^"]+"/)) {
    id = substr(attr, RSTART + 9, RLENGTH - 10)
  } else if (match(attr, /ID=[^;]+/)) {
    id = substr(attr, RSTART + 3, RLENGTH - 3)
  } else if (match(attr, /Name=[^;]+/)) {
    id = substr(attr, RSTART + 5, RLENGTH - 5)
  }
  gsub(/[[:space:]]+/, "_", id)
  return id
}
FNR==NR {
  chrlen[$1] = $2
  next
}
$0 !~ /^#/ && $3 == FT && ($1 in chrlen) {
  id = get_id($9)

  if ($7 == "+") {
    tss0 = $4 - 1
    s = tss0 - UP
    e = tss0 + DOWN
  } else if ($7 == "-") {
    tss1 = $5
    s = tss1 - DOWN
    e = tss1 + UP
  } else {
    next
  }

  if (s < 0) s = 0
  if (e > chrlen[$1]) e = chrlen[$1]
  if (e > s) print $1, s, e, id, ".", $7
}' "$CHROMSIZE" "$ANNO" \
  | bedtools sort -g "$CHROMSIZE" -i - \
  > "$OUTDIR/promoter_TSS_${PROMOTER_UP}up_${PROMOTER_DOWN}down.bed"

cut -f1-3 "$OUTDIR/promoter_TSS_${PROMOTER_UP}up_${PROMOTER_DOWN}down.bed" \
  | bedtools sort -g "$CHROMSIZE" -i - \
  | bedtools merge -i - \
  > "$OUTDIR/promoter_TSS_${PROMOTER_UP}up_${PROMOTER_DOWN}down.merged.bed"

# ------------------------------------------------------------
# 3. TTS downstream region
#
# + strand:
#   TTS = gene end
#   TTS region = [gene_end, gene_end + TTS_BP)
#
# - strand:
#   TTS = gene start
#   TTS region = [gene_start - TTS_BP, gene_start)
# ------------------------------------------------------------
awk -v DOWN="$TTS_BP" -v FT="$FEATURE_TYPE" 'BEGIN{FS=OFS="\t"}
function get_id(attr, id) {
  id = attr
  if (match(attr, /gene_id "[^"]+"/)) {
    id = substr(attr, RSTART + 9, RLENGTH - 10)
  } else if (match(attr, /ID=[^;]+/)) {
    id = substr(attr, RSTART + 3, RLENGTH - 3)
  } else if (match(attr, /Name=[^;]+/)) {
    id = substr(attr, RSTART + 5, RLENGTH - 5)
  }
  gsub(/[[:space:]]+/, "_", id)
  return id
}
FNR==NR {
  chrlen[$1] = $2
  next
}
$0 !~ /^#/ && $3 == FT && ($1 in chrlen) {
  id = get_id($9)

  if ($7 == "+") {
    s = $5
    e = $5 + DOWN
  } else if ($7 == "-") {
    s = $4 - 1 - DOWN
    e = $4 - 1
  } else {
    next
  }

  if (s < 0) s = 0
  if (e > chrlen[$1]) e = chrlen[$1]
  if (e > s) print $1, s, e, id, ".", $7
}' "$CHROMSIZE" "$ANNO" \
  | bedtools sort -g "$CHROMSIZE" -i - \
  > "$OUTDIR/tts_${TTS_BP}bp.bed"

cut -f1-3 "$OUTDIR/tts_${TTS_BP}bp.bed" \
  | bedtools sort -g "$CHROMSIZE" -i - \
  | bedtools merge -i - \
  > "$OUTDIR/tts_${TTS_BP}bp.merged.bed"

# ------------------------------------------------------------
# 4. gene-associated union
# 注意：promoter 和 gene body 本来会重叠，所以这里只能作为 union 使用，
# 不能把 promoter / gene body / TTS 的 bp 直接相加
# ------------------------------------------------------------
cat \
  "$OUTDIR/promoter_TSS_${PROMOTER_UP}up_${PROMOTER_DOWN}down.merged.bed" \
  "$OUTDIR/gene_body.merged.bed" \
  "$OUTDIR/tts_${TTS_BP}bp.merged.bed" \
  | bedtools sort -g "$CHROMSIZE" -i - \
  | bedtools merge -i - \
  > "$OUTDIR/gene_associated.merged.bed"

bedtools complement \
  -i "$OUTDIR/gene_associated.merged.bed" \
  -g "$CHROMSIZE" \
  > "$OUTDIR/non_gene_associated.bed"

# ------------------------------------------------------------
# 5. total bp summary
# ------------------------------------------------------------
{
  echo -e "region\ttotal_bp"
  for f in \
    "$OUTDIR/promoter_TSS_${PROMOTER_UP}up_${PROMOTER_DOWN}down.merged.bed" \
    "$OUTDIR/gene_body.merged.bed" \
    "$OUTDIR/tts_${TTS_BP}bp.merged.bed" \
    "$OUTDIR/gene_associated.merged.bed" \
    "$OUTDIR/non_gene_associated.bed"
  do
    name=$(basename "$f" .bed)
    bp=$(awk 'BEGIN{s=0}{s+=($3-$2)}END{print s+0}' "$f")
    echo -e "${name}\t${bp}"
  done
} > "$OUTDIR/region_total_bp.tsv"

echo "[OK] annotation BED files created in: $OUTDIR"

chmod +x build_annotation_regions_3class.sh
# 运行脚本
OUTROOT=/data/mshe/deepRloopPro_data/annotation_beds_3class
SCRIPT=/data/mshe/deepRloopPro_data/build_annotation_regions_3class.sh
PROMOTER_UP=2000
PROMOTER_DOWN=500
TTS_BP=2000
FEATURE_TYPE=gene

mkdir -p "$OUTROOT"

while IFS=$'\t' read -r sp anno chrom
do
    echo "=================================================="
    echo "[INFO] processing $sp"

    bash "$SCRIPT" \
      "$anno" \
      "$chrom" \
      "$OUTROOT/$sp" \
      "$PROMOTER_UP" \
      "$PROMOTER_DOWN" \
      "$TTS_BP" \
      "$FEATURE_TYPE"

done < /data/mshe/deepRloopPro_data/annotation_list_new.tsv

