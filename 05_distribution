# 图1：按 plot_group 分面的物种堆叠比例图
p1 <- ggplot(plot_df, aes(x = species_short, y = prop, fill = region)) +
  geom_col(width = 0.8) +
  coord_flip() +
  facet_grid(plot_group ~ ., scales = "free_y", space = "free_y") +
  scale_y_continuous(labels = function(x) paste0(round(x * 100), "%")) +
  labs(
    x = NULL,
    y = "Proportion of R-loop 3' endpoints",
    fill = "Region",
    title = "Genomic distribution of R-loop 3' endpoints across legume lineages"
  ) +
  theme_bw() +
  theme(
    strip.text.y = element_text(angle = 0, face = "bold"),
    panel.grid.major.y = element_blank(),
    panel.grid.minor = element_blank(),
    axis.text.y = element_text(size = 8),
    plot.title = element_text(hjust = 0.5)
  )

ggsave(
  filename = file.path(indir, "05_rloop_endpoint_region_proportion_by_branch_facet.pdf"),
  plot = p1,
  width = 9,
  height = 8
)

ggsave(
  filename = file.path(indir, "05_rloop_endpoint_region_proportion_by_branch_facet.png"),
  plot = p1,
  width = 9,
  height = 8,
  dpi = 300
)

