    # 已经跑完：跳过
    if [[ -s "$FINALBED" ]]; then
        echo "[SKIP DONE] $RUN_PREFIX"
        continue
    fi
    # 已经在跑：跳过
    if pgrep -af "deepRloopPredict.py" \
        | grep -Fq -- "--prefix ${RUN_PREFIX}"
    then
        echo "[SKIP RUNNING] $RUN_PREFIX"
        continue
    fi
    # 控制并行任务数
    while [[ "$(jobs -pr | wc -l)" -ge "$MAXJOBS" ]]; do
        sleep 30
    done
    (
        cd "$OUTDIR"
        echo "[START] $(date '+%F %T') $RUN_PREFIX"
        deepRloopPredict.py \
          --h5 "$MODEL" \
          --fasta "$FASTA" \
          --chromsize "$CHROMSIZE" \
          --prefix "$RUN_PREFIX" \
          --strand rev \
          > "$LOGFILE" 2>&1
        if [[ ! -s "$FINALBED" ]]; then
            echo "[ERROR] expected output not generated: $FINALBED" >&2
            exit 1
        fi
        echo "[DONE] $(date '+%F %T') $RUN_PREFIX"
    ) &
done < "$RUNLIST"
wait
