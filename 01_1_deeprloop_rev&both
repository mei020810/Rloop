#!/usr/bin/env bash
set -euo pipefail
RUNLIST=/data/mshe/deepRloopPro_data/new_list_A.tsv
FWDDIR=/data/mshe/deepRloopPro_data/deepRloop_results_A
REVDIR=/data/mshe/deepRloopPro_data/deepRloop_results_A_rev
BOTHDIR=/data/mshe/deepRloopPro_data/deepRloop_results_A_both
UNIONDIR=/data/mshe/deepRloopPro_data/deepRloop_results_A_union
OUTDIR=/data/mshe/deepRloopPro_data/fwd_rev_overlap
mkdir -p "$BOTHDIR" "$UNIONDIR" "$OUTDIR"
SUMMARY="$OUTDIR/fwd_rev_overlap_summary.tsv"

echo -e \
"species\tfwd_n\trev_n\tboth_n\tfwd_overlap_n\tfwd_overlap_frac\trev_overlap_n\trev_overlap_frac\tjaccard\tintersection_bp\tunion_bp" \
> "$SUMMARY"

while IFS=$'\t' read -r sp fasta chrom fai
do
    [[ -z "${sp:-}" ]] && continue

    echo "=================================================="
    echo "[INFO] $sp"

    fwd="$FWDDIR/${sp}_final_predict.bed"
    rev="$REVDIR/${sp}_rev_final_predict.bed"

    both="$BOTHDIR/${sp}_final_predict.bed"
    union="$UNIONDIR/${sp}_total_rloop_union.bed"

    if [[ ! -s "$fwd" ]]; then
        echo "[WARN] missing fwd: $fwd" >&2
        continue
    fi

    if [[ ! -s "$rev" ]]; then
        echo "[WARN] missing rev: $rev" >&2
        continue
    fi

    if [[ ! -s "$chrom" ]]; then
        echo "[WARN] missing chromsize: $chrom" >&2
        continue
    fi

    # --------------------------------------------------------
    # 1. 简单strand QC
    # --------------------------------------------------------
    fwd_bad=$(awk '$0 !~ /^#/ && $6 != "+" {n++} END{print n+0}' "$fwd")
    rev_bad=$(awk '$0 !~ /^#/ && $6 != "-" {n++} END{print n+0}' "$rev")

    if [[ "$fwd_bad" -ne 0 ]]; then
        echo "[WARN] $sp fwd contains $fwd_bad non-+ records" >&2
    fi

    if [[ "$rev_bad" -ne 0 ]]; then
        echo "[WARN] $sp rev contains $rev_bad non-- records" >&2
    fi

    # --------------------------------------------------------
    # 2. both strands
    # 保留+/-信息，不merge
    # --------------------------------------------------------
    cat "$fwd" "$rev" \
      | bedtools sort -g "$chrom" -i - \
      > "$both"

    # --------------------------------------------------------
    # 3. total R-loop coordinate union
    # 不考虑strand，对所有坐标取并集
    # --------------------------------------------------------
    cut -f1-3 "$both" \
      | bedtools sort -g "$chrom" -i - \
      | bedtools merge -i - \
      > "$union"

    # --------------------------------------------------------
    # 4. peak-level overlap
    # fwd有多少peak与任意rev peak重叠
    # rev同理
    # --------------------------------------------------------
    fwd_n=$(wc -l < "$fwd")
    rev_n=$(wc -l < "$rev")
    both_n=$(wc -l < "$both")

    fwd_overlap_n=$(
        bedtools intersect -u -a "$fwd" -b "$rev" \
        | wc -l
    )

    rev_overlap_n=$(
        bedtools intersect -u -a "$rev" -b "$fwd" \
        | wc -l
    )

    fwd_overlap_frac=$(
        awk -v x="$fwd_overlap_n" -v n="$fwd_n" \
        'BEGIN{
            if(n>0) printf "%.6f", x/n;
            else print "NA"
        }'
    )

    rev_overlap_frac=$(
        awk -v x="$rev_overlap_n" -v n="$rev_n" \
        'BEGIN{
            if(n>0) printf "%.6f", x/n;
            else print "NA"
        }'
    )

    # --------------------------------------------------------
    # 5. bp-level overlap: bedtools jaccard
    #
    # 先各自在strand内部merge，避免单侧自身重叠影响结果
    # --------------------------------------------------------
    fwd_tmp="$OUTDIR/${sp}.fwd.merged.tmp.bed"
    rev_tmp="$OUTDIR/${sp}.rev.merged.tmp.bed"

    cut -f1-3 "$fwd" \
      | bedtools sort -g "$chrom" -i - \
      | bedtools merge -i - \
      > "$fwd_tmp"

    cut -f1-3 "$rev" \
      | bedtools sort -g "$chrom" -i - \
      | bedtools merge -i - \
      > "$rev_tmp"

    read -r intersection_bp union_bp jaccard n_intersections < <(
        bedtools jaccard \
          -a "$fwd_tmp" \
          -b "$rev_tmp" \
        | awk 'NR==2 {print $1,$2,$3,$4}'
    )

    rm -f "$fwd_tmp" "$rev_tmp"

    echo -e \
"${sp}\t${fwd_n}\t${rev_n}\t${both_n}\t${fwd_overlap_n}\t${fwd_overlap_frac}\t${rev_overlap_n}\t${rev_overlap_frac}\t${jaccard}\t${intersection_bp}\t${union_bp}" \
    >> "$SUMMARY"

    echo "[OK] both : $both"
    echo "[OK] union: $union"

done < "$RUNLIST"

echo
echo "[ALL DONE]"
echo "summary: $SUMMARY"

chmod +x build_both_union_overlap.sh
