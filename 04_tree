    )
  }
}

spearman_test <- function(data, x, y) {
  tmp <- data %>%
    filter(!is.na(.data[[x]]), !is.na(.data[[y]]))

  if (nrow(tmp) < 3) {
    return(tibble(
      x = x,
      y = y,
      n = nrow(tmp),
      spearman_rho = NA_real_,
      p_value = NA_real_
    ))
  }

  ct <- suppressWarnings(cor.test(tmp[[x]], tmp[[y]], method = "spearman", exact = FALSE))

  tibble(
    x = x,
    y = y,
    n = nrow(tmp),
    spearman_rho = unname(ct$estimate),
    p_value = ct$p.value
  )
}

