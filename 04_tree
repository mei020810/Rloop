                for (g in mrna_gene) mrna_n++
                for (g in transcript_gene) transcript_n++

                if (mrna_n > 0) {
                    print mrna_n, "mRNA_proxy"
                } else if (transcript_n > 0) {
                    print transcript_n, "transcript_proxy"
                } else {
                    print 0, "unavailable"
                }
            }
        }
        ' "$chromsize" "$anno"
    fi
}

get_rloop_total_and_mean() {
    local bed="$1"

    awk '
    NF >= 3 {
        len = $3 - $2
        if (len > 0) {
            sum += len
            n++
        }
    }
    END {
        if (n > 0) {
            printf "%d %.2f\n", sum, sum/n
        } else {
            print "0 0"
        }
    }
    ' "$bed"
}

get_rloop_merged_total() {
    local bed="$1"

    if command -v bedtools >/dev/null 2>&1; then
        bedtools sort -i "$bed" \
        | bedtools merge -i - \
        | awk '{sum += $3 - $2} END{print sum+0}'
    else
        sort -k1,1 -k2,2n "$bed" \
        | awk '
        BEGIN {
            chr = ""
            start = -1
            end = -1
            sum = 0
        }

        NF >= 3 {
            c = $1
            s = $2
            e = $3

            if (chr == "") {
                chr = c
                start = s
                end = e
                next
            }

            if (c == chr && s <= end) {
                if (e > end) end = e
            } else {
                sum += end - start
                chr = c
                start = s
                end = e
            }
        }

        END {
            if (chr != "") sum += end - start
            print sum+0
        }
        '
    fi
}

get_rloop_per_biological_chr_counts() {
    local prefix="$1"
    local chromsize="$2"
    local bed="$3"

    if [[ -f "$chromsize" ]]; then
        awk -v prefix="$prefix" '
        function norm_chr(c) {
            if (prefix ~ /^Vicia_faba/) {
                if (c ~ /(^|[^0-9A-Za-z])1S$/ || c ~ /[Cc]hr[^0-9A-Za-z]*1S$/ || c ~ /[Cc]hromosome[^0-9A-Za-z]*1S$/) return "Chr1"
                if (c ~ /(^|[^0-9A-Za-z])1L$/ || c ~ /[Cc]hr[^0-9A-Za-z]*1L$/ || c ~ /[Cc]hromosome[^0-9A-Za-z]*1L$/) return "Chr1"
            }
            return c
        }

        NR == FNR {
            c = norm_chr($1)
            if (!(c in seen)) {
                seen[c] = 1
                order[++n] = c
                count[c] = 0
            }
            next
        }

        NF >= 3 {
            c = norm_chr($1)
            count[c]++
            if (!(c in seen)) {
                seen[c] = 1
                order[++n] = c
            }
        }

        END {
            for (i = 1; i <= n; i++) {
                c = order[i]
                printf "%s:%d", c, count[c]+0
                if (i < n) printf ";"
            }
            printf "\n"
        }
        ' "$chromsize" "$bed"
    else
        awk -v prefix="$prefix" '
        function norm_chr(c) {
            if (prefix ~ /^Vicia_faba/) {
                if (c ~ /(^|[^0-9A-Za-z])1S$/ || c ~ /[Cc]hr[^0-9A-Za-z]*1S$/ || c ~ /[Cc]hromosome[^0-9A-Za-z]*1S$/) return "Chr1"
                if (c ~ /(^|[^0-9A-Za-z])1L$/ || c ~ /[Cc]hr[^0-9A-Za-z]*1L$/ || c ~ /[Cc]hromosome[^0-9A-Za-z]*1L$/) return "Chr1"
            }
            return c
        }

        NF >= 3 {
            c = norm_chr($1)
            count[c]++
        }

        END {
            first = 1
            for (c in count) {
                if (!first) printf ";"
                printf "%s:%d", c, count[c]
                first = 0
            }
            printf "\n"
        }
        ' "$bed"
    fi
}

for bed in $(ls "${BED_DIR}"/*_final_predict.bed 2>/dev/null | sort)
do
    [[ -e "$bed" ]] || continue

    prefix=$(basename "$bed" _final_predict.bed)

    fasta="${FASTAMAP[$prefix]:-NA}"
    chromsize="${CHRMAP[$prefix]:-NA}"
    fai="${FAIMAP[$prefix]:-NA}"
    anno="${ANNOMAP[$prefix]:-NA}"

    subfamily="${SUBFAMILY[$prefix]:-NA}"
    major_branch="${BRANCH[$prefix]:-NA}"

    if [[ "$chromsize" == "NA" || ! -f "$chromsize" ]]; then
        echo "[WARN] $prefix 的 chromsize 不存在: $chromsize" >&2
    fi

    if [[ "$fai" == "NA" || ! -f "$fai" ]]; then
        echo "[WARN] $prefix 的 fai 不存在: $fai" >&2
    fi

    if [[ "$anno" == "NA" || ! -f "$anno" ]]; then
        echo "[WARN] $prefix 的 annotation 不存在: $anno" >&2
    fi

    # 如果 annotation_list 和 new_list_A 里的 chromsize 不一致，给警告
    anno_chrom="${ANNO_CHRMAP[$prefix]:-NA}"
    if [[ "$anno_chrom" != "NA" && "$chromsize" != "NA" && "$anno_chrom" != "$chromsize" ]]; then
        echo "[WARN] $prefix chromsize 不一致:" >&2
        echo "       new_list_A:        $chromsize" >&2
        echo "       annotation_list:   $anno_chrom" >&2
    fi

    # assembly size 直接由 fai 计算
    if [[ "$fai" != "NA" && -f "$fai" ]]; then
        assembly_size=$(get_assembly_size_from_fai "$fai")
    else
        assembly_size="NA"
    fi

    # 组装主染色体数、主染色体总长度、生物学染色体数
    if [[ "$chromsize" != "NA" && -f "$chromsize" ]]; then
        assembly_main_chr_n=$(wc -l < "$chromsize")
        biological_main_chr_size=$(awk '{sum += $2} END{print sum+0}' "$chromsize")
        biological_main_chr_n=$(get_biological_main_chr_n "$prefix" "$chromsize")
    else
        assembly_main_chr_n="NA"
        biological_main_chr_size="NA"
        biological_main_chr_n="NA"
    fi

    # gene number on biological main chromosomes
    # Vicia_faba 的 Chr1S + Chr1L 都保留在 chromsize 中，所以 gene 总数不需要额外合并；
    # 合并只影响每条染色体 counts 和 per-chr mean 的分母。
    if [[ "$anno" != "NA" && -f "$anno" && "$chromsize" != "NA" && -f "$chromsize" ]]; then
        read -r gene_number gene_number_source < <(get_gene_number_and_source_main_chr "$anno" "$chromsize")
    else
        gene_number="NA"
        gene_number_source="NA"
    fi

    # gene density
    if [[ "$gene_number" != "NA" && "$biological_main_chr_size" != "NA" && "$biological_main_chr_size" -gt 0 ]]; then
        gene_density=$(awk -v g="$gene_number" -v s="$biological_main_chr_size" 'BEGIN{printf "%.4f", g/(s/1000000)}')
    else
        gene_density="NA"
    fi

    # GC content，可选
    if [[ "$fasta" != "NA" && -f "$fasta" && "$chromsize" != "NA" && -f "$chromsize" ]]; then
        gc_content=$(get_main_chr_gc "$fasta" "$chromsize")
    else
        gc_content="NA"
    fi

    # R-loop 区域数
    rloop_n=$(awk 'NF >= 3 {n++} END{print n+0}' "$bed")

    # R-loop 原始总长度和平均长度
    read -r rloop_total_bp rloop_mean_len < <(get_rloop_total_and_mean "$bed")

    # R-loop merge 后非冗余覆盖长度
    rloop_merged_total_bp=$(get_rloop_merged_total "$bed")

    # R-loop density / coverage / biological chromosome mean
    if [[ "$biological_main_chr_size" != "NA" && "$biological_main_chr_n" != "NA" && "$biological_main_chr_size" -gt 0 && "$biological_main_chr_n" -gt 0 ]]; then
        rloop_density=$(awk -v r="$rloop_n" -v l="$biological_main_chr_size" 'BEGIN{printf "%.2f", r/l*100000000}')
        rloop_coverage=$(awk -v t="$rloop_total_bp" -v l="$biological_main_chr_size" 'BEGIN{printf "%.6f", t/l}')
        rloop_merged_coverage=$(awk -v t="$rloop_merged_total_bp" -v l="$biological_main_chr_size" 'BEGIN{printf "%.6f", t/l}')
        rloop_per_biological_chr_mean=$(awk -v r="$rloop_n" -v n="$biological_main_chr_n" 'BEGIN{printf "%.2f", r/n}')
        rloop_per_biological_chr_counts=$(get_rloop_per_biological_chr_counts "$prefix" "$chromsize" "$bed")
    else
        rloop_density="NA"
        rloop_coverage="NA"
        rloop_merged_coverage="NA"
        rloop_per_biological_chr_mean="NA"
        rloop_per_biological_chr_counts=$(get_rloop_per_biological_chr_counts "$prefix" "$chromsize" "$bed")
    fi

    printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" \
        "$prefix" \
        "$subfamily" \
        "$major_branch" \
        "$assembly_size" \
        "$assembly_main_chr_n" \
        "$biological_main_chr_n" \
        "$biological_main_chr_size" \
        "$gene_number" \
        "$gene_number_source" \
        "$gene_density" \
        "$gc_content" \
        "$rloop_n" \
        "$rloop_total_bp" \
        "$rloop_merged_total_bp" \
        "$rloop_mean_len" \
        "$rloop_density" \
        "$rloop_coverage" \
        "$rloop_merged_coverage" \
        "$rloop_per_biological_chr_mean" \
        "$rloop_per_biological_chr_counts" >> "$OUT"
done

echo "已生成: $OUT"
echo
column -t -s $'\t' "$OUT" | less -S
EOF

