# 9. fwd/rev overlap QC
# ============================================================

overlap <- read_tsv(
  overlap_file,
  show_col_types = FALSE,
  locale = locale(encoding = "UTF-8")
)

required_overlap <- c(
  "species",
  "fwd_overlap_frac",
  "rev_overlap_frac",
  "intersection_bp",
  "union_bp",
  "jaccard"
)

missing_overlap <- setdiff(
  required_overlap,
  colnames(overlap)
)

if (length(missing_overlap) > 0) {

  stop(
    "overlap表缺少必要列: ",
    paste(
      missing_overlap,
      collapse = ", "
    )
  )
}

overlap <- overlap %>%
  mutate(
    across(
      c(
        fwd_overlap_frac,
        rev_overlap_frac,
        intersection_bp,
        union_bp,
        jaccard
      ),
      as.numeric
    )
  ) %>%
  left_join(
    df %>%
      select(
        species,
        species_label,
        lineage
      ),
    by = "species"
  ) %>%
  mutate(

    mean_peak_overlap_frac =
      (
        fwd_overlap_frac +
        rev_overlap_frac
      ) / 2,

    mean_peak_overlap_percent =
      mean_peak_overlap_frac * 100,

    jaccard_percent =
      jaccard * 100
  )

write_tsv(
  overlap,
  file.path(
    outdir,
    "fwd_rev_overlap_plot_cleaned.tsv"
  )
)

