#!/usr/bin/env bash
set -euo pipefail
RUNLIST=/data/mshe/deepRloopPro_data/new_list_A.tsv
FWDDIR=/data/mshe/deepRloopPro_data/deepRloop_results_A
REVDIR=/data/mshe/deepRloopPro_data/deepRloop_results_A_rev
OUTDIR=/data/mshe/deepRloopPro_data/fwd_rev_overlap
OUT="$OUTDIR/fwd_rev_overlap_summary.tsv"
mkdir -p "$OUTDIR"
# ------------------------------------------------------------
# 输出列说明
#
# fwd_n:
#   fwd预测peak总数
# rev_n:
#   rev预测peak总数
# fwd_overlap_n:
#   至少与一个rev peak发生重叠的fwd peak数量
# rev_overlap_n:
#   至少与一个fwd peak发生重叠的rev peak数量
# fwd_unique_n / rev_unique_n:
#   完全不与对方strand发生重叠的peak数量
# fwd_overlap_frac / rev_overlap_frac:
#   上述overlap peak占本strand所有peak的比例
# intersection_bp:
#   fwd和rev在基因组上共同覆盖的非冗余bp
# union_bp:
#   fwd或rev任意一个方向覆盖的非冗余bp
# jaccard:
#   intersection_bp / union_bp
#   0 = 完全不重叠
#   1 = 完全相同
# ------------------------------------------------------------

printf "species\tfwd_n\trev_n\tfwd_overlap_n\tfwd_unique_n\tfwd_overlap_frac\trev_overlap_n\trev_unique_n\trev_overlap_frac\tfwd_merged_bp\trev_merged_bp\tintersection_bp\tunion_bp\tjaccard\n" \
> "$OUT"

while IFS=$'\t' read -r sp fasta chrom fai rest
do
    [[ -z "${sp:-}" ]] && continue
    [[ "$sp" == "species" || "$sp" == "prefix" ]] && continue

    echo "=================================================="
    echo "[INFO] $sp"

    fwd="$FWDDIR/${sp}_final_predict.bed"
    rev="$REVDIR/${sp}_rev_final_predict.bed"

    if [[ ! -s "$fwd" ]]; then
        echo "[WARN] missing fwd: $fwd" >&2
        continue
    fi

    if [[ ! -s "$rev" ]]; then
        echo "[WARN] missing rev: $rev" >&2
        continue
    fi

    if [[ ! -s "$chrom" ]]; then
        echo "[WARN] missing chromsize: $chrom" >&2
        continue
    fi

    TMPDIR=$(mktemp -d "$OUTDIR/${sp}.XXXXXX")
    trap 'rm -rf "$TMPDIR"' EXIT

    fwd_sorted="$TMPDIR/fwd.sorted.bed"
    rev_sorted="$TMPDIR/rev.sorted.bed"

    fwd_merged="$TMPDIR/fwd.merged.bed"
    rev_merged="$TMPDIR/rev.merged.bed"

    # --------------------------------------------------------
    # 1. 只保留chromsize中列出的染色体/主序列，并排序
    # --------------------------------------------------------
    awk 'BEGIN{FS=OFS="\t"}
    NR==FNR {
        keep[$1]=1
        next
    }
    $0 !~ /^#/ && NF>=3 && ($1 in keep) && $3>$2 {
        print
    }' "$chrom" "$fwd" \
      | bedtools sort -g "$chrom" -i - \
      > "$fwd_sorted"

    awk 'BEGIN{FS=OFS="\t"}
    NR==FNR {
        keep[$1]=1
        next
    }
    $0 !~ /^#/ && NF>=3 && ($1 in keep) && $3>$2 {
        print
    }' "$chrom" "$rev" \
      | bedtools sort -g "$chrom" -i - \
      > "$rev_sorted"

    # --------------------------------------------------------
    # 2. strand QC
    # --------------------------------------------------------
    fwd_bad=$(
        awk '$6!="+" {n++} END{print n+0}' "$fwd_sorted"
    )

    rev_bad=$(
        awk '$6!="-" {n++} END{print n+0}' "$rev_sorted"
    )

    if [[ "$fwd_bad" -ne 0 ]]; then
        echo "[WARN] $sp: $fwd_bad fwd records are not +" >&2
    fi

    if [[ "$rev_bad" -ne 0 ]]; then
        echo "[WARN] $sp: $rev_bad rev records are not -" >&2
    fi

    # --------------------------------------------------------
    # 3. peak总数
    # --------------------------------------------------------
    fwd_n=$(wc -l < "$fwd_sorted")
    rev_n=$(wc -l < "$rev_sorted")

    # --------------------------------------------------------
    # 4. peak-level overlap
    # -u:
    #   一个peak只计一次，即使它与多个对方peak重叠
    # -v:
    #   完全不与对方peak重叠
    # --------------------------------------------------------
    fwd_overlap_n=$(
        bedtools intersect \
          -u \
          -a "$fwd_sorted" \
          -b "$rev_sorted" \
        | wc -l
    )

    rev_overlap_n=$(
        bedtools intersect \
          -u \
          -a "$rev_sorted" \
          -b "$fwd_sorted" \
        | wc -l
    )

    fwd_unique_n=$(
        bedtools intersect \
          -v \
          -a "$fwd_sorted" \
          -b "$rev_sorted" \
        | wc -l
    )

    rev_unique_n=$(
        bedtools intersect \
          -v \
          -a "$rev_sorted" \
          -b "$fwd_sorted" \
        | wc -l
    )

    fwd_overlap_frac=$(
        awk -v x="$fwd_overlap_n" -v n="$fwd_n" '
        BEGIN{
            if(n>0) printf "%.6f",x/n;
            else print "NA"
        }'
    )

    rev_overlap_frac=$(
        awk -v x="$rev_overlap_n" -v n="$rev_n" '
        BEGIN{
            if(n>0) printf "%.6f",x/n;
            else print "NA"
        }'
    )

    # --------------------------------------------------------
    # 5. 各strand内部先merge
    # 这样后面的bp-level overlap不会因为同一strand内部peak
    # 自身重叠而重复计数
    # --------------------------------------------------------
    cut -f1-3 "$fwd_sorted" \
      | bedtools merge -i - \
      > "$fwd_merged"

    cut -f1-3 "$rev_sorted" \
      | bedtools merge -i - \
      > "$rev_merged"

    # 各方向非冗余覆盖bp
    fwd_merged_bp=$(
        awk '{s += $3-$2} END{print s+0}' "$fwd_merged"
    )

    rev_merged_bp=$(
        awk '{s += $3-$2} END{print s+0}' "$rev_merged"
    )

    # --------------------------------------------------------
    # 6. fwd/rev共同覆盖bp
    # 两边都已经各自merge，因此这里的overlap长度不会重复累计
    # --------------------------------------------------------
    intersection_bp=$(
        bedtools intersect \
          -a "$fwd_merged" \
          -b "$rev_merged" \
          -wo \
        | awk '{s += $NF} END{print s+0}'
    )

    # --------------------------------------------------------
    # 7. union bp
    #
    # |A union B| = |A| + |B| - |A intersection B|
    # --------------------------------------------------------
    union_bp=$(
        awk \
          -v a="$fwd_merged_bp" \
          -v b="$rev_merged_bp" \
          -v i="$intersection_bp" \
          'BEGIN{print a+b-i}'
    )

    # Jaccard
    jaccard=$(
        awk \
          -v i="$intersection_bp" \
          -v u="$union_bp" '
        BEGIN{
            if(u>0) printf "%.6f",i/u;
            else print "NA"
        }'
    )

    # --------------------------------------------------------
    # 8. 基本一致性检查
    # --------------------------------------------------------
    if [[ $((fwd_overlap_n + fwd_unique_n)) -ne "$fwd_n" ]]; then
        echo "[WARN] $sp: fwd overlap + unique != total" >&2
    fi

    if [[ $((rev_overlap_n + rev_unique_n)) -ne "$rev_n" ]]; then
        echo "[WARN] $sp: rev overlap + unique != total" >&2
    fi

    # --------------------------------------------------------
    # 9. 输出
    # --------------------------------------------------------
    printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" \
        "$sp" \
        "$fwd_n" \
        "$rev_n" \
        "$fwd_overlap_n" \
        "$fwd_unique_n" \
        "$fwd_overlap_frac" \
        "$rev_overlap_n" \
        "$rev_unique_n" \
        "$rev_overlap_frac" \
        "$fwd_merged_bp" \
        "$rev_merged_bp" \
        "$intersection_bp" \
        "$union_bp" \
        "$jaccard" \
        >> "$OUT"

    echo "[OK] fwd overlap fraction = $fwd_overlap_frac"
    echo "[OK] rev overlap fraction = $rev_overlap_frac"
    echo "[OK] Jaccard              = $jaccard"

    rm -rf "$TMPDIR"
    trap - EXIT

done < "$RUNLIST"

echo
echo "[ALL DONE]"
echo "$OUT"

chmod +x make_fwd_rev_overlap_summary.sh
bash make_fwd_rev_overlap_summary.sh
column -t -s $'\t' /data/mshe/deepRloopPro_data/fwd_rev_overlap/fwd_rev_overlap_summary.tsv | less -S

