#!/usr/bin/env Rscript
# ============================================================
# R-loop comparative plots
# 输入1:
#   genedata_rloop_summary_both_union.tsv
# 输入2:
#   fwd_rev_overlap_summary.tsv
# 输入3:
#   输出目录
# 用法:
# Rscript plot_rloop_both_union_final.R \
#   genedata_rloop_summary_both_union.tsv \
#   fwd_rev_overlap/fwd_rev_overlap_summary.tsv \
#   rloop_plots_both_union
# ============================================================
args <- commandArgs(trailingOnly = TRUE)
summary_file <- if (length(args) >= 1) {
  args[1]
} else {
  "genedata_rloop_summary_both_union.tsv"
}
overlap_file <- if (length(args) >= 2) {
  args[2]
} else {
  "fwd_rev_overlap/fwd_rev_overlap_summary.tsv"
}
outdir <- if (length(args) >= 3) {
  args[3]
} else {
  "rloop_plots_both_union"
}
dir.create(outdir, recursive = TRUE, showWarnings = FALSE)

# ============================================================
# packages
# ============================================================

need_pkgs <- c(
  "readr",
  "dplyr",
  "ggplot2",
  "forcats",
  "stringr"
)

for (pkg in need_pkgs) {
  if (!requireNamespace(pkg, quietly = TRUE)) {
    stop(
      sprintf(
        "缺少R包: %s\n请安装: install.packages('%s')",
        pkg, pkg
      )
    )
  }
}

library(readr)
library(dplyr)
library(ggplot2)
library(forcats)
library(stringr)

has_ggrepel <- requireNamespace("ggrepel", quietly = TRUE)

# ============================================================
# read summary
# ============================================================

df <- read_tsv(
  summary_file,
  show_col_types = FALSE,
  locale = locale(encoding = "UTF-8")
)

required_cols <- c(
  "species",
  "subfamily",
  "major_branch",
  "assembly_size_bp",
  "main_chr_n",
  "main_chr_size_bp",
  "gene_number_main_chr",
  "gene_density_per_Mb",
  "GC_content_main_chr",
  "fwd_event_number",
  "rev_event_number",
  "Rloop_strand_event_number",
  "Rloop_strand_event_mean_length",
  "Rloop_strand_event_density_per_100Mb",
  "Rloop_union_total_bp",
  "Rloop_union_coverage_ratio"
)

missing_cols <- setdiff(required_cols, colnames(df))

if (length(missing_cols) > 0) {
  stop(
    "主表缺少必要列: ",
    paste(missing_cols, collapse = ", ")
  )
}

num_cols <- c(
  "assembly_size_bp",
  "main_chr_n",
  "main_chr_size_bp",
  "gene_number_main_chr",
  "gene_density_per_Mb",
  "GC_content_main_chr",
  "fwd_event_number",
  "rev_event_number",
  "Rloop_strand_event_number",
  "Rloop_strand_event_mean_length",
  "Rloop_strand_event_density_per_100Mb",
  "Rloop_union_total_bp",
  "Rloop_union_coverage_ratio"
)

df <- df %>%
  mutate(
    across(
      all_of(num_cols),
      ~ suppressWarnings(as.numeric(.x))
    )
  )

# ============================================================
# species label
# ============================================================

make_species_label <- function(x) {

  m <- stringr::str_match(
    x,
    "^([^_]+)_([^_]+)"
  )

  ifelse(
    !is.na(m[, 1]),
    paste(m[, 2], m[, 3]),
    x
  )
}

# ============================================================
# lineage grouping
#
# basal_non_papilionoid不是一个真正等价的branch，
# 因此这三个物种直接使用subfamily。
# ============================================================

lineage_order <- c(
  "Cercidoideae",
  "Dialioideae",
  "Detarioideae",
  "Mimoseae",
  "Cassieae",
  "genistoid",
  "dalbergioid",
  "IRLC",
  "millettioid_phaseoloid"
)

df <- df %>%
  mutate(

    species_label = make_species_label(species),

    lineage = case_when(
      is.na(major_branch) ~ subfamily,
      major_branch == "" ~ subfamily,
      major_branch == "NA" ~ subfamily,
      major_branch == "basal_non_papilionoid" ~ subfamily,
      TRUE ~ major_branch
    ),

    lineage = factor(
      lineage,
      levels = lineage_order
    ),

    main_chr_size_Gb =
      main_chr_size_bp / 1e9,

    Rloop_union_coverage_percent =
      Rloop_union_coverage_ratio * 100,

    # GC如果存的是0~1则转成百分比；
    # 如果本来就是百分比则保持不变
    GC_content_percent = case_when(
      is.na(GC_content_main_chr) ~ NA_real_,
      GC_content_main_chr <= 1 ~
        GC_content_main_chr * 100,
      TRUE ~ GC_content_main_chr
    )
  )

