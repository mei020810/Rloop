#!/usr/bin/env bash
set -euo pipefail

# 用法:
# bash rloop_overlap_four_regions.sh <species> <final_bed> <annotation_dir> <outdir>
#
# 例如:
# bash rloop_overlap_four_regions.sh \
#   Glycine_max_GCA_000004515.5 \
#   /data/mshe/deepRloopPro_data/deepRloop_results_A/Glycine_max_GCA_000004515.5_final_predict.bed \
#   /data/mshe/deepRloopPro_data/annotation_beds/Glycine_max_GCA_000004515.5 \
#   /data/mshe/deepRloopPro_data/region_overlap_four

if [[ $# -lt 4 ]]; then
  echo "Usage: bash $0 <species> <final_bed> <annotation_dir> <outdir>" >&2
  exit 1
fi

SPECIES="$1"
FINALBED="$2"
ANN_DIR="$3"
OUTDIR="$4"
mkdir -p "$OUTDIR"
PROM="$ANN_DIR/promoter_only.bed"
GENE="$ANN_DIR/gene_only.bed"
OVER="$ANN_DIR/promoter_gene_overlap.bed"
INTER="$ANN_DIR/intergenic_only.bed"

for f in "$FINALBED" "$PROM" "$GENE" "$OVER" "$INTER"; do
  if [[ ! -f "$f" ]]; then
    echo "[ERROR] missing file: $f" >&2
    exit 1
  fi
done

TOTAL_RLOOP_COUNT=$(wc -l < "$FINALBED")
TOTAL_RLOOP_BP=$(awk 'BEGIN{s=0} {s+=($3-$2)} END{print s+0}' "$FINALBED")

PROM_BP=$(awk 'BEGIN{s=0} {s+=($3-$2)} END{print s+0}' "$PROM")
GENE_BP=$(awk 'BEGIN{s=0} {s+=($3-$2)} END{print s+0}' "$GENE")
OVER_BP=$(awk 'BEGIN{s=0} {s+=($3-$2)} END{print s+0}' "$OVER")
INTER_BP=$(awk 'BEGIN{s=0} {s+=($3-$2)} END{print s+0}' "$INTER")

PROM_COUNT=$(bedtools intersect -a "$FINALBED" -b "$PROM" -u | wc -l)
GENE_COUNT=$(bedtools intersect -a "$FINALBED" -b "$GENE" -u | wc -l)
OVER_COUNT=$(bedtools intersect -a "$FINALBED" -b "$OVER" -u | wc -l)
INTER_COUNT=$(bedtools intersect -a "$FINALBED" -b "$INTER" -u | wc -l)

PROM_OVERLAP_BP=$(bedtools intersect -a "$FINALBED" -b "$PROM" -wo | awk 'BEGIN{s=0} {s+=$NF} END{print s+0}')
GENE_OVERLAP_BP=$(bedtools intersect -a "$FINALBED" -b "$GENE" -wo | awk 'BEGIN{s=0} {s+=$NF} END{print s+0}')
OVER_OVERLAP_BP=$(bedtools intersect -a "$FINALBED" -b "$OVER" -wo | awk 'BEGIN{s=0} {s+=$NF} END{print s+0}')
INTER_OVERLAP_BP=$(bedtools intersect -a "$FINALBED" -b "$INTER" -wo | awk 'BEGIN{s=0} {s+=$NF} END{print s+0}')

OUTTSV="$OUTDIR/${SPECIES}.region_overlap_four.tsv"

{
  echo -e "species\ttotal_rloop_count\ttotal_rloop_bp\tregion\tregion_bp\toverlap_rloop_count\toverlap_bp\tcount_fraction\tbp_fraction\tregion_density_bp_per_Mb"

  awk -v sp="$SPECIES" -v tc="$TOTAL_RLOOP_COUNT" -v tb="$TOTAL_RLOOP_BP" \
      -v rb="$PROM_BP" -v oc="$PROM_COUNT" -v ob="$PROM_OVERLAP_BP" '
      BEGIN{
        cf=(tc>0?oc/tc:0);
        bf=(tb>0?ob/tb:0);
        dens=(rb>0?ob/rb*1000000:0);
        printf "%s\t%d\t%d\tpromoter_only\t%d\t%d\t%d\t%.6f\t%.6f\t%.6f\n", sp, tc, tb, rb, oc, ob, cf, bf, dens
      }'

  awk -v sp="$SPECIES" -v tc="$TOTAL_RLOOP_COUNT" -v tb="$TOTAL_RLOOP_BP" \
      -v rb="$GENE_BP" -v oc="$GENE_COUNT" -v ob="$GENE_OVERLAP_BP" '
      BEGIN{
        cf=(tc>0?oc/tc:0);
        bf=(tb>0?ob/tb:0);
        dens=(rb>0?ob/rb*1000000:0);
        printf "%s\t%d\t%d\tgene_only\t%d\t%d\t%d\t%.6f\t%.6f\t%.6f\n", sp, tc, tb, rb, oc, ob, cf, bf, dens
      }'

  awk -v sp="$SPECIES" -v tc="$TOTAL_RLOOP_COUNT" -v tb="$TOTAL_RLOOP_BP" \
      -v rb="$OVER_BP" -v oc="$OVER_COUNT" -v ob="$OVER_OVERLAP_BP" '
      BEGIN{
        cf=(tc>0?oc/tc:0);
        bf=(tb>0?ob/tb:0);
        dens=(rb>0?ob/rb*1000000:0);
        printf "%s\t%d\t%d\tpromoter_gene_overlap\t%d\t%d\t%d\t%.6f\t%.6f\t%.6f\n", sp, tc, tb, rb, oc, ob, cf, bf, dens
      }'

  awk -v sp="$SPECIES" -v tc="$TOTAL_RLOOP_COUNT" -v tb="$TOTAL_RLOOP_BP" \
      -v rb="$INTER_BP" -v oc="$INTER_COUNT" -v ob="$INTER_OVERLAP_BP" '
      BEGIN{
        cf=(tc>0?oc/tc:0);
        bf=(tb>0?ob/tb:0);
        dens=(rb>0?ob/rb*1000000:0);
        printf "%s\t%d\t%d\tintergenic_only\t%d\t%d\t%d\t%.6f\t%.6f\t%.6f\n", sp, tc, tb, rb, oc, ob, cf, bf, dens
      }'
} > "$OUTTSV"
echo "[OK] $SPECIES -> $OUTTSV"

