ROOT=/data/mshe/deepRloopPro_data/genome_file
OUT=/data/mshe/deepRloopPro_data/chromsize_primary
mkdir -p "$OUT"
find "$ROOT" -type f -name "*_genomic.fna" | while read -r fasta; do
    species_dir=$(basename "$(dirname "$(dirname "$(dirname "$(dirname "$fasta")")")")")
    echo "[INFO] indexing $species_dir"

    samtools faidx "$fasta"
    fai="${fasta}.fai"
    out="${OUT}/${species_dir}.chromsize"

    if awk '$1 ~ /^CM/' "$fai" | grep -q .; then
        awk 'BEGIN{OFS="\t"} $1 ~ /^CM/ {print $1,$2}' "$fai" > "$out"
        echo "[OK] $species_dir -> CM only"
    elif awk '$1 ~ /^(chr|Chr|CHR)/ || $1 ~ /chromosome/i' "$fai" | grep -q .; then
        awk 'BEGIN{OFS="\t"} $1 ~ /^(chr|Chr|CHR)/ || $1 ~ /chromosome/i {print $1,$2}' "$fai" > "$out"
        echo "[OK] $species_dir -> chr only"
    else
        cut -f1,2 "$fai" > "$out"
        echo "[WARN] $species_dir -> no obvious chromosome prefix, kept all sequences"
    fi
done
