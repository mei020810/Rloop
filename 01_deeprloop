#!/usr/bin/env bash
set -euo pipefail

# 用法:
# bash make_four_regions.sh <annotation_species_dir> [promoter_bp]
#
# 例如:
# bash make_four_regions.sh /data/mshe/deepRloopPro_data/annotation_beds/Glycine_max_GCA_000004515.5 2000

if [[ $# -lt 1 ]]; then
  echo "Usage: bash $0 <annotation_species_dir> [promoter_bp]" >&2
  exit 1
fi

ANN_DIR="$1"
PROMOTER_BP="${2:-2000}"
PROMOTER="$ANN_DIR/promoter_${PROMOTER_BP}bp.merged.bed"
GENE="$ANN_DIR/gene_body.merged.bed"
INTERGENIC="$ANN_DIR/intergenic.bed"

for f in "$PROMOTER" "$GENE" "$INTERGENIC"; do
  if [[ ! -f "$f" ]]; then
    echo "[ERROR] missing file: $f" >&2
    exit 1
  fi
done

# 1) promoter_only = promoter - gene
bedtools subtract \
  -a "$PROMOTER" \
  -b "$GENE" \
  > "$ANN_DIR/promoter_only.bed"

# 2) gene_only = gene - promoter
bedtools subtract \
  -a "$GENE" \
  -b "$PROMOTER" \
  > "$ANN_DIR/gene_only.bed"

# 3) promoter_gene_overlap = promoter ∩ gene
bedtools intersect \
  -a "$PROMOTER" \
  -b "$GENE" \
  > "$ANN_DIR/promoter_gene_overlap.bed"

# 4) intergenic 直接沿用
cp "$INTERGENIC" "$ANN_DIR/intergenic_only.bed"

# 5) 各区域总长度
awk 'BEGIN{s=0} {s+=($3-$2)} END{print s+0}' "$ANN_DIR/promoter_only.bed" \
  > "$ANN_DIR/promoter_only.total_bp.txt"

awk 'BEGIN{s=0} {s+=($3-$2)} END{print s+0}' "$ANN_DIR/gene_only.bed" \
  > "$ANN_DIR/gene_only.total_bp.txt"

awk 'BEGIN{s=0} {s+=($3-$2)} END{print s+0}' "$ANN_DIR/promoter_gene_overlap.bed" \
  > "$ANN_DIR/promoter_gene_overlap.total_bp.txt"

awk 'BEGIN{s=0} {s+=($3-$2)} END{print s+0}' "$ANN_DIR/intergenic_only.bed" \
  > "$ANN_DIR/intergenic_only.total_bp.txt"

echo "[OK] 4-region files created in $ANN_DIR"
echo "  promoter_only.bed"
echo "  gene_only.bed"
echo "  promoter_gene_overlap.bed"
echo "  intergenic_only.bed"

chmod +x make_exclusive_regions.sh

