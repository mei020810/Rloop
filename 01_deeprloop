#!/usr/bin/env bash
set -euo pipefail
# 用法:
# bash make_annotation_beds_one.sh \
#   /data/mshe/deepRloopPro_data/genome_file/Glycine_max_GCA_000004515.5 \
#   /data/mshe/deepRloopPro_data/chromsize_primary/Glycine_max_GCA_000004515.5.chromsize \
#   /data/mshe/deepRloopPro_data/annotation_beds/Glycine_max_GCA_000004515.5 \
#   2000
#
# 参数:
#   $1 species_dir   物种目录
#   $2 chromsize     对应 chromsize 文件
#   $3 outdir        输出目录
#   $4 promoter_bp   可选，默认 2000

if [[ $# -lt 3 ]]; then
  echo "Usage: bash $0 <species_dir> <chromsize> <outdir> [promoter_bp]" >&2
  exit 1
fi

SPECIES_DIR="$1"
CHROMSIZE="$2"
OUTDIR="$3"
PROMOTER_BP="${4:-2000}"
mkdir -p "$OUTDIR"
need_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "[ERROR] missing command: $1" >&2
    exit 1
  }
}

need_cmd awk
need_cmd sort
need_cmd find
need_cmd bedtools

if [[ ! -d "$SPECIES_DIR" ]]; then
  echo "[ERROR] species_dir not found: $SPECIES_DIR" >&2
  exit 1
fi

if [[ ! -f "$CHROMSIZE" ]]; then
  echo "[ERROR] chromsize not found: $CHROMSIZE" >&2
  exit 1
fi

GTF=$(find "$SPECIES_DIR" -type f -name "genomic.gtf" | head -n 1 || true)

if [[ -z "${GTF:-}" ]]; then
  echo "[ERROR] genomic.gtf not found under: $SPECIES_DIR" >&2
  exit 1
fi

echo "[INFO] species_dir  = $SPECIES_DIR"
echo "[INFO] gtf         = $GTF"
echo "[INFO] chromsize   = $CHROMSIZE"
echo "[INFO] outdir      = $OUTDIR"
echo "[INFO] promoter_bp = $PROMOTER_BP"

# 1) gene body
# GTF: 1-based inclusive
# BED: 0-based half-open
awk 'BEGIN{FS=OFS="\t"}
     FNR==NR {
       keep[$1] = 1
       next
     }
     $0 !~ /^#/ && $3 == "gene" && ($1 in keep) {
       start = $4 - 1
       if (start < 0) start = 0
       print $1, start, $5, $9, ".", $7
     }' "$CHROMSIZE" "$GTF" \
  | sort -k1,1 -k2,2n -k3,3n \
  > "$OUTDIR/gene_body.bed"

# 2) promoter
# + strand: upstream of TSS
# - strand: downstream in genomic coordinate, but upstream in transcription sense
awk -v UP="$PROMOTER_BP" 'BEGIN{FS=OFS="\t"}
     FNR==NR {
       chrlen[$1] = $2
       next
     }
     $0 !~ /^#/ && $3 == "gene" {
       if (!($1 in chrlen)) next

       if ($7 == "+") {
         s = $4 - UP - 1
         if (s < 0) s = 0
         e = $4 - 1
         if (e > s) print $1, s, e, $9, ".", $7
       }
       else if ($7 == "-") {
         s = $5
         e = $5 + UP
         if (e > chrlen[$1]) e = chrlen[$1]
         if (e > s) print $1, s, e, $9, ".", $7
       }
     }' "$CHROMSIZE" "$GTF" \
  | sort -k1,1 -k2,2n -k3,3n \
  > "$OUTDIR/promoter_${PROMOTER_BP}bp.bed"

# 3) merge gene body
cut -f1-3 "$OUTDIR/gene_body.bed" \
  | sort -k1,1 -k2,2n -k3,3n \
  | bedtools merge -i - \
  > "$OUTDIR/gene_body.merged.bed"

# 4) merge promoter
cut -f1-3 "$OUTDIR/promoter_${PROMOTER_BP}bp.bed" \
  | sort -k1,1 -k2,2n -k3,3n \
  | bedtools merge -i - \
  > "$OUTDIR/promoter_${PROMOTER_BP}bp.merged.bed"

# 5) gene + promoter union
cat "$OUTDIR/gene_body.merged.bed" "$OUTDIR/promoter_${PROMOTER_BP}bp.merged.bed" \
  | sort -k1,1 -k2,2n -k3,3n \
  | bedtools merge -i - \
  > "$OUTDIR/gene_plus_promoter.merged.bed"

# 6) intergenic
bedtools complement \
  -i "$OUTDIR/gene_plus_promoter.merged.bed" \
  -g "$CHROMSIZE" \
  > "$OUTDIR/intergenic.bed"

# 7) total bp summary
awk 'BEGIN{s=0} {s+=($3-$2)} END{print s}' "$OUTDIR/gene_body.merged.bed" \
  > "$OUTDIR/gene_body.total_bp.txt"

awk 'BEGIN{s=0} {s+=($3-$2)} END{print s}' "$OUTDIR/promoter_${PROMOTER_BP}bp.merged.bed" \
  > "$OUTDIR/promoter_${PROMOTER_BP}bp.total_bp.txt"

awk 'BEGIN{s=0} {s+=($3-$2)} END{print s}' "$OUTDIR/intergenic.bed" \
  > "$OUTDIR/intergenic.total_bp.txt"

echo "[OK] BED files created:"
echo "  $OUTDIR/gene_body.bed"
echo "  $OUTDIR/promoter_${PROMOTER_BP}bp.bed"
echo "  $OUTDIR/intergenic.bed"

chmod +x build_annotation_beds.sh
bash build_annotation_beds.sh \
  /data/mshe/deepRloopPro_data/genome_file/Glycine_max_GCA_000004515.5 \
  /data/mshe/deepRloopPro_data/chromsize_primary/Glycine_max_GCA_000004515.5.chromsize \
  /data/mshe/deepRloopPro_data/annotation_beds/Glycine_max_GCA_000004515.5 \
  2000

ROOT=/data/mshe/deepRloopPro_data/genome_file
CHRDIR=/data/mshe/deepRloopPro_data/chromsize_primary
OUTROOT=/data/mshe/deepRloopPro_data/annotation_beds
SCRIPT=/data/mshe/deepRloopPro_data/build_annotation_beds.sh
PROMOTER_BP=2000
for sp in \
  Senna_tora_GCA_014851425.1 \
  Arachis_hypogaea_GCA_039854485.1 \
  Medicago_truncatula_GCA_003473485.2 \
  Cicer_arietinum_GCA_000331145.2 \
  Lotus_japonicus_GCA_012489685.2 \
  Trifolium_repens_GCA_030408175.1 \
  Glycine_max_GCA_000004515.5
do
    species_dir="$ROOT/$sp"
    chromsize="$CHRDIR/${sp}.chromsize"
    outdir="$OUTROOT/$sp"
    echo "[INFO] processing $sp"
    if [[ ! -d "$species_dir" ]]; then
        echo "[WARN] missing species_dir: $species_dir"
        continue
    fi
    if [[ ! -f "$chromsize" ]]; then
        echo "[WARN] missing chromsize: $chromsize"
        continue
    fi
    bash "$SCRIPT" "$species_dir" "$chromsize" "$outdir" "$PROMOTER_BP" \
      || echo "[ERROR] failed: $sp"
done

