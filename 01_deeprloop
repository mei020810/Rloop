#!/usr/bin/env bash
set -euo pipefail
MODEL=/home/mshe/deepRloop_models/transfer_scale128_single_13_0.29202.hdf5
RUNLIST=/data/mshe/deepRloopPro_data/run_list_A.tsv
OUTDIR=/data/mshe/deepRloopPro_data/deepRloop_results_A
LOGDIR=/data/mshe/deepRloopPro_data/deepRloop_logs_A
MAXJOBS=8
mkdir -p "$OUTDIR" "$LOGDIR"
while IFS=$'\t' read -r PREFIX FASTA CHROMSIZE
do
    FINALBED="${OUTDIR}/${PREFIX}_final_predict.bed"
    LOGFILE="${LOGDIR}/${PREFIX}.log"

    # 已经跑完：跳过
    if [ -s "$FINALBED" ]; then
        echo "[SKIP DONE] $PREFIX"
        continue
    fi

    # 已经在跑：跳过
    if pgrep -af "deepRloopPredict.py.*${PREFIX}" >/dev/null 2>&1; then
        echo "[SKIP RUNNING] $PREFIX"
        continue
    fi

    while [ "$(jobs -r | wc -l)" -ge "$MAXJOBS" ]; do
        sleep 30
    done

    (
        cd "$OUTDIR"
        echo "[START] $(date '+%F %T') $PREFIX"
        deepRloopPredict.py \
          --h5 "$MODEL" \
          --fasta "$FASTA" \
          --chromsize "$CHROMSIZE" \
          --prefix "$PREFIX" \
          > "$LOGFILE" 2>&1
        echo "[DONE] $(date '+%F %T') $PREFIX"
    ) &
done < "$RUNLIST"
wait
echo "[ALL DONE] $(date '+%F %T')"
EOF
