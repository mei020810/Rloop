import sys
import csv
from collections import defaultdict
from Bio import Phylo

treefile, mapfile = sys.argv[1:3]

groups = defaultdict(set)

with open(mapfile) as f:
    for row in csv.DictReader(f, delimiter="\t"):
        groups[row["Subfamily"]].add(row["Species"])

original = Phylo.read(treefile, "newick")
all_species = {x.name for x in original.get_terminals()}
mapped_species = set().union(*groups.values())

