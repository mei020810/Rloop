import sys
import re
from pathlib import Path
from collections import Counter
from statistics import median

base = Path(sys.argv[1])
wd = base / "WorkingDirectory"

og_list = base / "Species_Tree/Orthogroups_for_concatenated_alignment.txt"
seq_dir = wd / "Sequences_ids"

names = {}

with open(wd / "SpeciesIDs.txt") as f:
    for line in f:
        m = re.match(r"^(\d+):\s*(\S+)", line.strip())
        if m:
            sid, filename = m.groups()
            names[sid] = Path(filename).stem

ogs = [
    x.strip()
    for x in og_list.read_text().splitlines()
    if x.strip()
]

selected_single = Counter()
selected_present = Counter()
records = []

for og in ogs:
    f = seq_dir / f"{og}.fa"

    if not f.exists():
        raise FileNotFoundError(f"找不到OG序列文件: {f}")

    counts = Counter()

    with f.open() as handle:
        for line in handle:
            if line.startswith(">"):
                gene_id = line[1:].split()[0]
                m = re.match(r"^(\d+)_\d+$", gene_id)

                if not m:
                    raise ValueError(
                        f"无法解析OrthoFinder内部基因ID: {gene_id}"
                    )

                sid = m.group(1)

                if sid not in names:
                    raise ValueError(f"未知物种编号: {sid}")

                counts[sid] += 1

    n_present = sum(v >= 1 for v in counts.values())
    n_single = sum(v == 1 for v in counts.values())
    n_multi = sum(v > 1 for v in counts.values())

    records.append((og, n_present, n_single, n_multi))

    for sid, count in counts.items():
        selected_present[sid] += 1
        if count == 1:
            selected_single[sid] += 1

print("=== 建树OG整体情况 ===")
print("OG数量:", len(records))
print("物种数量:", len(names))

for label, index in [
    ("至少存在1个拷贝的物种数", 1),
    ("恰好单拷贝的物种数", 2)
]:
    values = [r[index] for r in records]

    print(f"\n{label}:")
    print("最少:", min(values))
    print("中位数:", median(values))
    print("最多:", max(values))

print("\n=== 不同物种覆盖率的OG数量 ===")

N = len(names)

for pct in [0.25, 0.50, 0.70, 0.90]:
    a = sum(r[1] / N >= pct for r in records)
    b = sum(r[2] / N >= pct for r in records)

    print(
        f">={pct:.0%}: "
        f"存在基因的OG={a}, "
        f"单拷贝OG={b}"
    )

print("\n=== 每个物种在108个OG中的覆盖情况 ===")
print("Species\tPresent_OGs\tSingle_Copy_OGs")

rows = []

for sid, name in names.items():
    rows.append((
        name,
        selected_present[sid],
        selected_single[sid]
    ))

for name, n_present, n_single in sorted(
    rows, key=lambda x: x[2]
):
    print(f"{name}\t{n_present}\t{n_single}")

print("\n=== 108个OG中单拷贝覆盖最高的前10个 ===")
for og, present, single, multi in sorted(
    records, key=lambda x: -x[2]
)[:10]:
    print(
        f"{og}\tPresent={present}\t"
        f"Single={single}\tMulti={multi}"
    )
