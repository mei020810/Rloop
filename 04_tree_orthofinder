import sys
import re
from pathlib import Path

wd = Path(sys.argv[1])

# species ID -> species name
species = {}

with open(wd / "SpeciesIDs.txt") as f:
    for line in f:
        m = re.match(r"^\s*(\d+):\s*(.+?)\s*$", line)
        if not m:
            continue

        sid, filename = m.groups()
        name = Path(filename).name
        name = re.sub(
            r"\.(fa|faa|fasta|fas|pep|fna)(\.gz)?$",
            "",
            name,
            flags=re.I
        )

        species[sid] = name

tree_dir = wd / "Trees_ids"
trees = sorted(tree_dir.glob("OG*.txt"))

if not trees:
    raise SystemExit("ERROR: Trees_ids 中没有找到 OG*.txt")

out_tree = Path("06_orthofinder/astral_pro/gene_trees.nwk")
out_map  = Path("06_orthofinder/astral_pro/gene_to_species.tsv")

seen_genes = set()
n_tree = 0

with open(out_tree, "w") as fout, open(out_map, "w") as fmap:

    for fn in trees:
        text = fn.read_text().strip()

        if not text:
            continue

        fout.write(text + "\n")
        n_tree += 1

        # OrthoFinder internal gene IDs，例如 12_3456
        genes = re.findall(r"(?<=[(,])([0-9]+_[0-9]+)(?=[:),])", text)

        for gene in genes:
            if gene in seen_genes:
                continue

            sid = gene.split("_", 1)[0]

            if sid not in species:
                raise SystemExit(
                    f"ERROR: gene {gene} 找不到 species ID {sid}"
                )

            fmap.write(f"{gene}\t{species[sid]}\n")
            seen_genes.add(gene)

print("Gene trees:", n_tree)
print("Unique gene tips:", len(seen_genes))
print("Species:", len(species))
