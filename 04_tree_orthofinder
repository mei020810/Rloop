    helsum=$(find "$heldir" -name 'short_summary.specific*.txt' | head -1)

    [ -z "$pubsum" ] && {
        echo "[NO PUBLIC BUSCO] $pubsample"
        continue
    }

    [ -z "$helsum" ] && {
        echo "[NO HELIXER BUSCO] $pubsample"
        continue
    }

    get_busco () {
        line=$(grep -m1 -E 'C:[0-9.]+%' "$1")

        C=$(echo "$line" | sed -nE 's/.*C:([0-9.]+)%.*/\1/p')
        S=$(echo "$line" | sed -nE 's/.*S:([0-9.]+)%.*/\1/p')
        D=$(echo "$line" | sed -nE 's/.*D:([0-9.]+)%.*/\1/p')
        F=$(echo "$line" | sed -nE 's/.*F:([0-9.]+)%.*/\1/p')
        M=$(echo "$line" | sed -nE 's/.*M:([0-9.]+)%.*/\1/p')

        echo "$C $S $D $F $M"
    }

    read HC HS HD HF HM <<< "$(get_busco "$helsum")"
    read PC PS PD PF PM <<< "$(get_busco "$pubsum")"

    pn=$(grep -c '^>' "$p")

    DC=$(awk -v a="$PC" -v b="$HC" 'BEGIN{printf "%.1f",a-b}')
    DM=$(awk -v a="$PM" -v b="$HM" 'BEGIN{printf "%.1f",a-b}')
    DD=$(awk -v a="$PD" -v b="$HD" 'BEGIN{printf "%.1f",a-b}')

