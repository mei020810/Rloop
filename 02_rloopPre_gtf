#!/usr/bin/env bash
set -euo pipefail
# 用法:
# bash build_annotation_beds_from_anno.sh \
#   <annotation.gtf/gff/gff3> \
#   <chromsize> \
#   <outdir> \
#   [promoter_bp]
#
# 例子:
# bash build_annotation_beds_from_anno.sh \
#   /data/mshe/deepRloopPro_data/GTF_find/genome_file/Chamaecrista_fasciculata_LIS_genomic.gff3 \
#   /data/mshe/deepRloopPro_data/GTF_find/chromsize_primary/Chamaecrista_fasciculata_LIS.chromsize \
#   /data/mshe/deepRloopPro_data/annotation_beds_new/Chamaecrista_fasciculata_LIS \
#   2000

if [[ $# -lt 3 ]]; then
  echo "Usage: bash $0 <annotation.gtf/gff/gff3> <chromsize> <outdir> [promoter_bp]" >&2
  exit 1
fi

ANNO="$1"
CHROMSIZE="$2"
OUTDIR="$3"
PROMOTER_BP="${4:-2000}"

mkdir -p "$OUTDIR"

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "[ERROR] missing command: $1" >&2
    exit 1
  }
}

need_cmd awk
need_cmd sort
need_cmd bedtools

if [[ ! -f "$ANNO" ]]; then
  echo "[ERROR] annotation file not found: $ANNO" >&2
  exit 1
fi

if [[ ! -f "$CHROMSIZE" ]]; then
  echo "[ERROR] chromsize not found: $CHROMSIZE" >&2
  exit 1
fi

echo "[INFO] annotation  = $ANNO"
echo "[INFO] chromsize   = $CHROMSIZE"
echo "[INFO] outdir      = $OUTDIR"
echo "[INFO] promoter_bp = $PROMOTER_BP"

# 1) gene body
# GTF/GFF3: 1-based inclusive
# BED: 0-based half-open
# 用 chromsize 第一列限制分析范围，和 deepRloop 预测一致
awk 'BEGIN{FS=OFS="\t"}
     FNR==NR {
       keep[$1] = 1
       next
     }
     $0 !~ /^#/ && $3 == "gene" && ($1 in keep) {
       start = $4 - 1
       if (start < 0) start = 0
       print $1, start, $5, $9, ".", $7
     }' "$CHROMSIZE" "$ANNO" \
  | sort -k1,1 -k2,2n -k3,3n \
  > "$OUTDIR/gene_body.bed"

gene_n=$(wc -l < "$OUTDIR/gene_body.bed")
if [[ "$gene_n" -eq 0 ]]; then
  echo "[ERROR] no gene features found after filtering by chromsize." >&2
  echo "[HINT] Check whether annotation seqids match chromsize seqids." >&2
  exit 1
fi

echo "[INFO] gene features retained: $gene_n"

# 2) promoter
# + strand: [TSS-UP, TSS-1]
# - strand: [TES+1, TES+UP]
awk -v UP="$PROMOTER_BP" 'BEGIN{FS=OFS="\t"}
     FNR==NR {
       chrlen[$1] = $2
       next
     }
     $0 !~ /^#/ && $3 == "gene" {
       if (!($1 in chrlen)) next

       if ($7 == "+") {
         s = $4 - UP - 1
         if (s < 0) s = 0
         e = $4 - 1
         if (e > s) print $1, s, e, $9, ".", $7
       }
       else if ($7 == "-") {
         s = $5
         e = $5 + UP
         if (e > chrlen[$1]) e = chrlen[$1]
         if (e > s) print $1, s, e, $9, ".", $7
       }
     }' "$CHROMSIZE" "$ANNO" \
  | sort -k1,1 -k2,2n -k3,3n \
  > "$OUTDIR/promoter_${PROMOTER_BP}bp.bed"

# 3) merge gene body
cut -f1-3 "$OUTDIR/gene_body.bed" \
  | sort -k1,1 -k2,2n -k3,3n \
  | bedtools merge -i - \
  > "$OUTDIR/gene_body.merged.bed"

# 4) merge promoter
cut -f1-3 "$OUTDIR/promoter_${PROMOTER_BP}bp.bed" \
  | sort -k1,1 -k2,2n -k3,3n \
  | bedtools merge -i - \
  > "$OUTDIR/promoter_${PROMOTER_BP}bp.merged.bed"

# 5) gene + promoter union
cat "$OUTDIR/gene_body.merged.bed" "$OUTDIR/promoter_${PROMOTER_BP}bp.merged.bed" \
  | sort -k1,1 -k2,2n -k3,3n \
  | bedtools merge -i - \
  > "$OUTDIR/gene_plus_promoter.merged.bed"

# 6) intergenic = genome - (gene + promoter)
bedtools complement \
  -i "$OUTDIR/gene_plus_promoter.merged.bed" \
  -g "$CHROMSIZE" \
  > "$OUTDIR/intergenic.bed"

# 7) total bp summary
awk 'BEGIN{s=0} {s+=($3-$2)} END{print s+0}' "$OUTDIR/gene_body.merged.bed" \
  > "$OUTDIR/gene_body.total_bp.txt"

awk 'BEGIN{s=0} {s+=($3-$2)} END{print s+0}' "$OUTDIR/promoter_${PROMOTER_BP}bp.merged.bed" \
  > "$OUTDIR/promoter_${PROMOTER_BP}bp.total_bp.txt"

awk 'BEGIN{s=0} {s+=($3-$2)} END{print s+0}' "$OUTDIR/intergenic.bed" \
  > "$OUTDIR/intergenic.total_bp.txt"

echo "[OK] BED files created:"
echo "  $OUTDIR/gene_body.bed"
echo "  $OUTDIR/promoter_${PROMOTER_BP}bp.bed"
echo "  $OUTDIR/intergenic.bed"

chmod +x build_annotation_beds_from_anno.sh
