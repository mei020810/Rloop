#!/usr/bin/env bash
set -euo pipefail
ROOT=/data/mshe/deepRloopPro_data/GTF_find/genome_file
OUT=/data/mshe/deepRloopPro_data/GTF_find/chromsize_primary
mkdir -p "$OUT"
make_chromsize() {
    local species="$1"
    local fasta="$2"
    local mode="$3"
    local out="$OUT/${species}.chromsize"

    echo "=================================================="
    echo "[INFO] species: $species"
    echo "[INFO] fasta:   $fasta"
    echo "[INFO] mode:    $mode"

    if [[ ! -f "$fasta" ]]; then
        echo "[ERROR] missing fasta: $fasta" >&2
        return 1
    fi

    local fai="${fasta}.fai"

    case "$mode" in
        CM)
            awk 'BEGIN{OFS="\t"} $1 ~ /^CM/ {print $1,$2}' "$fai" > "$out"
            ;;
        NC_main)
            # NCBI RefSeq 主染色体常是 NC_，但叶绿体/线粒体也可能是 NC_ , 加长度过滤可去掉 organelle 和很小的非主序列
            awk 'BEGIN{OFS="\t"} $1 ~ /^NC_/ && $2 > 1000000 {print $1,$2}' "$fai" > "$out"
            ;;
        OX_main)
            awk 'BEGIN{OFS="\t"} $1 ~ /^OX/ && $2 > 1000000 {print $1,$2}' "$fai" > "$out"
            ;;
        Chamaecrista_LIS)
            awk 'BEGIN{OFS="\t"} $1 ~ /\.Chr[0-9][0-9]$/ {print $1,$2}' "$fai" > "$out"
            ;;
        Lablab_LIS)
            awk 'BEGIN{OFS="\t"} $1 ~ /\.chr[0-9][0-9]$/ {print $1,$2}' "$fai" > "$out"
            ;;
        *)
            echo "[ERROR] unknown mode: $mode" >&2
            return 1
            ;;
    esac

    echo "[OK] wrote: $out"
    echo "[INFO] retained sequences: $(wc -l < "$out")"
    cat "$out"
}

