#!/usr/bin/env bash
set -euo pipefail
SRC="00_genomes/unpacked" #基因组所在真正位置
DEST="00_genomes/genomes_fasta"
REPORT="00_genomes/genome_manifest.tsv"
mkdir -p "$DEST"
echo -e "Sample\tSource_FASTA\tFinal_FASTA\tStatus" > "$REPORT"
for d in "$SRC"/*; do
    [ -d "$d" ] || continue
    sample=$(basename "$d")
    echo "========================================"
    echo "Processing: $sample"
    mapfile -t fasta_files < <(
        find "$d" -type f -name "*.fna" | sort
    )
    n=${#fasta_files[@]}
    if [ "$n" -ne 1 ]; then
        echo "ERROR: found $n FASTA files"
        if [ "$n" -gt 0 ]; then
            printf '%s\n' "${fasta_files[@]}"
        fi
        echo -e "${sample}\tNA\tNA\tERROR_${n}_FASTA" \
            >> "$REPORT"

        continue
    fi
    fasta="${fasta_files[0]}"
    final="${DEST}/${sample}.fna"
    ln -sfn "$(realpath "$fasta")" "$final"
    echo "Source:"
    echo "$fasta"
    echo "Link:"
    echo "$final"
    echo -e "${sample}\t${fasta}\t${final}\tOK" \
        >> "$REPORT"
done
echo
echo "========================================"
echo "Finished"
echo
echo "Number of genome FASTA links:"
find "$DEST" -maxdepth 1 -type l -name "*.fna" | wc -l
echo
echo "Errors:"
grep -v $'\tOK$' "$REPORT" | tail -n +2 || true

