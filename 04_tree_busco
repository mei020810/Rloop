#!/usr/bin/env bash
set -euo pipefail
BENCH="01_busco_benchmark"
OUT="${BENCH}/busco_benchmark_compare.tsv"
# 提取一个BUSCO结果目录的指标
get_metrics() {
    local dir="$1"
    local timefile="$2"
    local summary line
    local C S D F M N SC runtime rss_kb rss_gib
    summary=$(find "$dir" \
        -maxdepth 1 \
        -type f \
        -name "short_summary.specific.*.txt" \
        | head -1)
    if [ -z "$summary" ]; then
        echo -e "NA\tNA\tNA\tNA\tNA\tNA\tNA\tNA\tNA"
        return
    fi
    line=$(grep -m1 -E 'C:[0-9.]+' "$summary" | tr -d '[:space:]')
    C=$(echo "$line" | sed -n 's/.*C:\([0-9.]*\)%.*/\1/p')
    S=$(echo "$line" | sed -n 's/.*S:\([0-9.]*\)%.*/\1/p')
    D=$(echo "$line" | sed -n 's/.*D:\([0-9.]*\)%.*/\1/p')
    F=$(echo "$line" | sed -n 's/.*F:\([0-9.]*\)%.*/\1/p')
    M=$(echo "$line" | sed -n 's/.*M:\([0-9.]*\)%.*/\1/p')
    N=$(echo "$line" | sed -n 's/.*n:\([0-9]*\).*/\1/p')
    SC=$(find "$dir" \
        -type f \
        -path "*/single_copy_busco_sequences/*.faa" \
        | wc -l)
    runtime="NA"
    rss_gib="NA"
    if [ -f "$timefile" ]; then
        runtime=$(grep -m1 "Elapsed (wall clock)" "$timefile" \
            | awk -F': ' '{print $NF}')
        rss_kb=$(grep -m1 "Maximum resident set size" "$timefile" \
            | awk '{print $NF}')
        if [[ "$rss_kb" =~ ^[0-9]+$ ]]; then
            rss_gib=$(awk -v kb="$rss_kb" \
                'BEGIN {printf "%.2f", kb/1024/1024}')
        fi
    fi
    echo -e \
"${C}\t${S}\t${D}\t${F}\t${M}\t${N}\t${SC}\t${runtime}\t${rss_gib}"
}
# 表头
echo -e \
"Species\tMeta_C\tMeta_S\tMeta_D\tMeta_F\tMeta_M\tN\tMeta_single\tMeta_time\tMeta_RAM_GiB\tAug_C\tAug_S\tAug_D\tAug_F\tAug_M\tAug_single\tAug_time\tAug_RAM_GiB\tCommon_single\tMeta_only\tAug_only" \
> "$OUT"
# 从目录名自动提取所有物种
mapfile -t species_list < <(
    find "$BENCH" \
        -maxdepth 1 \
        -mindepth 1 \
        -type d \
        -printf '%f\n' \
    | sed -E 's/_(metaeuk|augustus)$//' \
    | sort -u
)
for species in "${species_list[@]}"; do
    meta_dir="${BENCH}/${species}_metaeuk"
    aug_dir="${BENCH}/${species}_augustus"
    meta_time="${BENCH}/${species}_metaeuk.time.txt"
    aug_time="${BENCH}/${species}_augustus.time.txt"
    echo "Processing: $species"
    # 两种结果必须都存在
    if [ ! -d "$meta_dir" ] || [ ! -d "$aug_dir" ]; then
        echo "WARNING: missing MetaEuk or Augustus result for $species"
        continue
    fi
    IFS=$'\t' read -r \
        meta_C meta_S meta_D meta_F meta_M meta_N \
        meta_SC meta_runtime meta_RAM \
        <<< "$(get_metrics "$meta_dir" "$meta_time")"
    IFS=$'\t' read -r \
        aug_C aug_S aug_D aug_F aug_M aug_N \
        aug_SC aug_runtime aug_RAM \
        <<< "$(get_metrics "$aug_dir" "$aug_time")"
    # 两种方法共同判为single-copy的BUSCO
    common=$(
        comm -12 \
            <(
                find "$meta_dir" \
                    -type f \
                    -path "*/single_copy_busco_sequences/*.faa" \
                    -exec basename {} .faa \; \
                    | sort -u
            ) \
            <(
                find "$aug_dir" \
                    -type f \
                    -path "*/single_copy_busco_sequences/*.faa" \
                    -exec basename {} .faa \; \
                    | sort -u
            ) \
        | wc -l
    )
    meta_only=$((meta_SC - common))
    aug_only=$((aug_SC - common))
    echo -e \
"${species}\t${meta_C}\t${meta_S}\t${meta_D}\t${meta_F}\t${meta_M}\t${meta_N}\t${meta_SC}\t${meta_runtime}\t${meta_RAM}\t${aug_C}\t${aug_S}\t${aug_D}\t${aug_F}\t${aug_M}\t${aug_SC}\t${aug_runtime}\t${aug_RAM}\t${common}\t${meta_only}\t${aug_only}" \
    >> "$OUT"
done
echo
echo "Finished."
echo "Output: $OUT"

