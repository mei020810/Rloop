#!/usr/bin/env bash
set -euo pipefail
WORK=/data/mshe/deepRloopPro_data/rlooppre_75
MODEL=/home/mshe/deepRloop_models/transfer_scale128_single_13_0.29202.hdf5

RUNLIST="${1:-$WORK/run_list_new50_primary.tsv}"
MAXJOBS="${MAXJOBS:-2}"
MEM="${MEM:-high}"

OUT="$WORK/results_new50"
LOG="$WORK/logs_new50"

mkdir -p "$OUT" "$LOG"

[[ -s "$MODEL" && -s "$RUNLIST" ]] || {
    echo "[ERROR] Model or run list missing"
    exit 1
}

[[ "$MAXJOBS" =~ ^[1-9][0-9]*$ ]] || exit 1

run_one() {
    local prefix="$1"
    local fasta="$2"
    local chrom="$3"
    local strand="$4"
    local tag="$prefix"

    [[ "$strand" == "rev" ]] && tag="${prefix}_rev"

    local bed="$OUT/${tag}_final_predict.bed"
    local ok="$LOG/${tag}.ok"
    local fail="$LOG/${tag}.fail"

    # 已成功完成的任务不重复运行
    if [[ -f "$ok" && -s "$bed" ]]; then
        echo "[SKIP] $tag"
        return 0
    fi

    rm -f "$ok" "$fail" "$bed"

    echo "[START] $tag"

    if (
        cd "$OUT"
        deepRloopPredict.py \
            --h5 "$MODEL" \
            --fasta "$fasta" \
            --chromsize "$chrom" \
            --prefix "$tag" \
            --strand "$strand" \
            --threshold 0.5 \
            --mem "$MEM"
    ) > "$LOG/${tag}.log" 2>&1 && [[ -s "$bed" ]]
    then
        touch "$ok"
        echo "[DONE] $tag"
    else
        touch "$fail"
        echo "[FAIL] $tag (see $LOG/${tag}.log)"
        return 1
    fi
}

pids=()
failed=0

while IFS=$'\t' read -r prefix fasta chrom
do
    [[ -n "$prefix" ]] || continue

    if [[ ! -s "$fasta" || ! -s "$chrom" ]]; then
        echo "[ERROR] Missing input for $prefix"
        exit 1
    fi

    for strand in fwd rev
    do
        run_one "$prefix" "$fasta" "$chrom" "$strand" &
        pids+=("$!")

        # 每批最多同时运行 MAXJOBS 个任务
        if (( ${#pids[@]} >= MAXJOBS )); then
            for pid in "${pids[@]}"; do
                if ! wait "$pid"; then
                    failed=$((failed+1))
                fi
            done
            pids=()
        fi
    done
done < "$RUNLIST"

for pid in "${pids[@]}"; do
    if ! wait "$pid"; then
        failed=$((failed+1))
    fi
done

echo "============================"
echo "Failed tasks: $failed"

if (( failed > 0 )); then
    exit 1
fi
echo "[ALL DONE]"
BASH

