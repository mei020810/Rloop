#!/usr/bin/env python3
"""Review and prepare main-chromosome chromsize files for the fixed 75 legume assemblies.

Run on the user's Linux server with the original FASTA and FAI files:
  python3 /data/mshe/deepRloopPro_data/rlooppre_75/prepare_primary_chromsizes_75.py --inspect
  # After review/approval:
  python3 /data/mshe/deepRloopPro_data/rlooppre_75/prepare_primary_chromsizes_75.py --finalize

The script NEVER silently substitutes all scaffolds for main chromosomes.
An APPROVE_CANDIDATE decision requires manual inspection first. For an
assembly lacking named chromosomes, USE_ID_FILE (curated IDs) or an explicit
SCAFFOLD_ALL decision can be used, and the output marks those cases clearly.
"""

import argparse
import csv
import re
import shutil
import subprocess
import sys
from collections import Counter
from pathlib import Path

WORKDIR = Path('/data/mshe/deepRloopPro_data/rlooppre_75')
SELECTION = WORKDIR / 'selected_75_genomes.tsv'
CANDIDATE_DIR = WORKDIR / 'candidate_chromsizes'
PRIMARY_DIR = WORKDIR / 'chromsizes_primary'
OVERRIDE_DIR = WORKDIR / 'manual_seqids'
REPORT = WORKDIR / 'chromosome_candidates_75.tsv'
DETAILS = WORKDIR / 'chromosome_candidate_ids_75.tsv'
DECISIONS = WORKDIR / 'chromosome_decisions_75.tsv'
FINAL_RUNLIST = WORKDIR / 'run_list_75_primary.tsv'
FINAL_INFO = WORKDIR / 'genome_info_75_primary.tsv'

CHROM_RE = re.compile(r'^(?:chr(?:omosome)?[-_.]?)(?:\d{1,3}[ABD]?|[IVXLCDM]{1,5}|[XYZW])$', re.I)
CM_RE = re.compile(r'^CM\d+(?:\.\d+)?$', re.I)
NC_RE = re.compile(r'^NC_\d+(?:\.\d+)?$', re.I)
LG_RE = re.compile(r'^LG[-_.]?\d{1,3}[ABD]?$', re.I)
ORGANELLE_RE = re.compile(r'(chloroplast|plastid|mitochondr|mitogenome|chromosome\s*[MC]\b)', re.I)
NON_PRIMARY_RE = re.compile(r'(unlocalized|unplaced|alternate locus|alternate haplotype|alt[_ -]locus|_random\b|\bscaffold\b|\bcontig\b|\bpatch\b)', re.I)
RULE_ORDER = ('CM', 'CHR', 'NC', 'LG')
REVIEW_COLS = ['PREFIX', 'ASSEMBLY_OR_SOURCE', 'RULE', 'FASTA_SEQS', 'FASTA_BP',
               'CANDIDATE_SEQS', 'CANDIDATE_BP', 'CANDIDATE_PCT',
               'CANDIDATE_IDS_EXAMPLE', 'OTHER_IDS_EXAMPLE', 'COMMENT']


def write_tsv(path, fieldnames, rows):
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = path.with_suffix(path.suffix + '.tmp')
    with temp.open('w', encoding='utf-8', newline='') as fp:
        w = csv.DictWriter(fp, fieldnames=fieldnames, delimiter='\t', lineterminator='\n')
        w.writeheader()
        w.writerows(rows)
    temp.replace(path)


def load_selection():
    with SELECTION.open(encoding='utf-8', newline='') as fp:
        reader = csv.DictReader(fp, delimiter='\t')
        required = ('PREFIX', 'ASSEMBLY_OR_SOURCE', 'SOURCE_DIR', 'FASTA_FILENAME')
        if not reader.fieldnames or not all(x in reader.fieldnames for x in required):
            raise ValueError('Invalid selected_75_genomes.tsv header')
        rows = list(reader)
    counts = Counter(r['PREFIX'] for r in rows)
    if len(rows) != 75 or len(counts) != 75:
        raise ValueError(f'Expected 75 unique species, got {len(rows)} rows and {len(counts)} species')
    for r in rows:
        src = Path(r['SOURCE_DIR'])
        if not src.is_absolute() or Path(r['FASTA_FILENAME']).name != r['FASTA_FILENAME']:
            raise ValueError(f'Invalid source path for {r["PREFIX"]}')
    return rows


def read_fai(fasta):
    fai = Path(str(fasta) + '.fai')
    if not fai.is_file() or fai.stat().st_size == 0 or fai.stat().st_mtime < fasta.stat().st_mtime:
        if not shutil.which('samtools'):
            raise RuntimeError(f'No fresh .fai for {fasta}; samtools is unavailable')
        print(f'[INDEX] {fasta.name}', flush=True)
        subprocess.run(['samtools', 'faidx', str(fasta)], check=True)
    rows = []
    seen = set()
    with fai.open(encoding='utf-8') as fp:
        for n, raw in enumerate(fp, 1):
            f = raw.rstrip('\n\r').split('\t')
            if len(f) < 3:
                raise ValueError(f'FAI invalid at {fai}:{n} (need >=3 columns)')
            name, bp, offset = f[0], int(f[1]), int(f[2])
            if not name or name in seen or bp <= 0 or offset < 0:
                raise ValueError(f'Duplicate/invalid FAI record {fai}:{n}: {name}')
            seen.add(name)
            rows.append((name, bp, offset))
    if not rows:
        raise ValueError(f'FAI empty: {fai}')
    return rows


def header_at(fasta_handle, offset):
    """Retrieve only the FASTA header immediately before the sequence offset.

    No full FASTA scan; a small seek/read per chromosome-like candidate.
    """
    window = min(offset, 65536)
    fasta_handle.seek(offset - window)
    before = fasta_handle.read(window).rstrip(b'\r\n')
    header = before.rsplit(b'\n', 1)[-1].decode('utf-8', errors='replace').lstrip('\r')
    return header if header.startswith('>') else ''


def name_rule(name):
    if CM_RE.fullmatch(name):
        return 'CM'
    if CHROM_RE.fullmatch(name):
        return 'CHR'
    if NC_RE.fullmatch(name):
        return 'NC'
    if LG_RE.fullmatch(name):
        return 'LG'
    return ''


def inspect_one(row):
    fasta = Path(row['SOURCE_DIR']) / row['FASTA_FILENAME']
    if not fasta.is_file() or fasta.stat().st_size == 0:
        raise FileNotFoundError(f'FASTA absent/empty: {fasta}')
    seqs = read_fai(fasta)
    rule_lists = {x: [] for x in RULE_ORDER}
    skipped = []
    with fasta.open('rb') as fp:
        for name, size, offset in seqs:
            rule = name_rule(name)
            if not rule:
                continue
            header = header_at(fp, offset)
            # If header is unavailable, report it; do not auto-approve.
            if ORGANELLE_RE.search(name) or ORGANELLE_RE.search(header):
                skipped.append((name, 'organellar_name_or_header'))
                continue
            if NON_PRIMARY_RE.search(header) or NON_PRIMARY_RE.search(name):
                skipped.append((name, 'non_primary_header'))
                continue
            rule_lists[rule].append((name, size, header))

    active = next((rule for rule in RULE_ORDER if rule_lists[rule]), 'NONE')
    chosen = rule_lists[active] if active != 'NONE' else []
    chosen_names = {x[0] for x in chosen}
    other = [(n, bp) for n, bp, _ in seqs if n not in chosen_names]
    total_bp = sum(bp for _, bp, _ in seqs)
    selected_bp = sum(bp for _, bp, _ in chosen)
    alternatives = [x for x in RULE_ORDER if x != active and rule_lists[x]]
    comments = []
    if active == 'NONE':
        comments.append('NO_RECOGNIZABLE_CHROMOSOME_NAMES')
    if alternatives:
        comments.append('OTHER_CHROMOSOME_LIKE_IDS=' + ','.join(alternatives))
    if active == 'NC':
        comments.append('NC_ACCESSIONS_REQUIRE_NUCLEAR_CHROMOSOME_VERIFICATION')
    if active == 'LG':
        comments.append('LINKAGE_GROUPS_REQUIRE_ASSEMBLY_VERIFICATION')
    if len(chosen) == 1:
        comments.append('SINGLE_CANDIDATE_REVIEW')
    if chosen and selected_bp / total_bp < 0.60:
        comments.append('LOW_CHROMOSOME_BASE_FRACTION_REVIEW')
    if skipped:
        comments.append(f'EXCLUDED_HEADER_FLAGS={len(skipped)}')
    if any(not hdr for _, _, hdr in chosen):
        comments.append('HEADER_NOT_READ_FOR_SOME_CANDIDATES')
    summary = {
        'PREFIX': row['PREFIX'],
        'ASSEMBLY_OR_SOURCE': row['ASSEMBLY_OR_SOURCE'],
        'RULE': active,
        'FASTA_SEQS': len(seqs),
        'FASTA_BP': total_bp,
        'CANDIDATE_SEQS': len(chosen),
        'CANDIDATE_BP': selected_bp,
        'CANDIDATE_PCT': f'{100 * selected_bp / total_bp:.2f}',
        'CANDIDATE_IDS_EXAMPLE': ','.join(x[0] for x in chosen[:8]) or '-',
        'OTHER_IDS_EXAMPLE': ','.join(x[0] for x in sorted(other, key=lambda x: x[1], reverse=True)[:5]) or '-',
        'COMMENT': ';'.join(comments) or 'REVIEW_WITH_ASSEMBLY_INFORMATION',
    }
    return fasta, seqs, chosen, active, summary


def inspect_all(selected):
    CANDIDATE_DIR.mkdir(parents=True, exist_ok=True)
    summary_rows, detail_rows, result = [], [], {}
    for i, row in enumerate(selected, 1):
        fasta, seqs, chosen, rule, summary = inspect_one(row)
        name = row['PREFIX']
        print(f'[{i:02d}/75] {name}: {rule}, {len(chosen)} candidates, '
              f'{summary["CANDIDATE_PCT"]}% of assembly', flush=True)
        preview = CANDIDATE_DIR / (name + '.candidate.chrom.sizes')
        if chosen:
            preview.write_text(''.join(f'{sid}\t{bp}\n' for sid, bp, _ in chosen), encoding='utf-8')
        elif preview.exists():
            preview.unlink()
        summary_rows.append(summary)
        for sid, bp, header in chosen:
            detail_rows.append({'PREFIX': name, 'RULE': rule, 'SEQ_ID': sid,
                                'LENGTH_BP': bp, 'FASTA_HEADER': header})
        result[name] = (fasta, seqs, chosen, rule)

    write_tsv(REPORT, REVIEW_COLS, summary_rows)
    write_tsv(DETAILS, ['PREFIX', 'RULE', 'SEQ_ID', 'LENGTH_BP', 'FASTA_HEADER'], detail_rows)
    if not DECISIONS.exists():
        write_tsv(DECISIONS, ['PREFIX', 'ACTION', 'NOTE'],
                  [{'PREFIX': row['PREFIX'], 'ACTION': '', 'NOTE': ''} for row in selected])
        print(f'[CREATED] Decision template: {DECISIONS}')
    else:
        print(f'[KEEP] Existing decision file unchanged: {DECISIONS}')

    modes = Counter(r['RULE'] for r in summary_rows)
    print('[SUMMARY] ' + '  '.join(f'{rule}={modes[rule]}' for rule in [*RULE_ORDER, 'NONE']))
    print(f'[REPORT] {REPORT}')
    print(f'[DETAILS] {DETAILS}')
    print('[NOTE] Candidate chrom.sizes are NOT final prediction inputs.')
    return result


def load_decisions(selected):
    with DECISIONS.open(encoding='utf-8', newline='') as fp:
        reader = csv.DictReader(fp, delimiter='\t')
        if not reader.fieldnames or 'PREFIX' not in reader.fieldnames or 'ACTION' not in reader.fieldnames:
            raise ValueError('chromosome_decisions_75.tsv needs PREFIX and ACTION columns')
        rows = list(reader)
    choices = {}
    for row in rows:
        sp = row['PREFIX'].strip()
        if sp in choices:
            raise ValueError(f'Duplicate decision: {sp}')
        choices[sp] = row['ACTION'].strip().upper()
    missing = [r['PREFIX'] for r in selected if r['PREFIX'] not in choices or not choices[r['PREFIX']]]
    unknown = sorted(set(choices) - {r['PREFIX'] for r in selected})
    if missing or unknown or len(rows) != 75:
        raise ValueError('All 75 decisions required before --finalize. '
                         f'Missing/blank={len(missing)} (first: {missing[:10]}), unknown={unknown}')
    legal = {'APPROVE_CANDIDATE', 'USE_ID_FILE', 'SCAFFOLD_ALL'}
    invalid = {k: v for k, v in choices.items() if v not in legal}
    if invalid:
        raise ValueError(f'Invalid ACTION entries: {invalid}')
    return choices


def curated_ids(prefix):
    path = OVERRIDE_DIR / (prefix + '.txt')
    if not path.is_file():
        raise FileNotFoundError(f'USE_ID_FILE requires {path}')
    result = []
    with path.open(encoding='utf-8') as fp:
        for line in fp:
            item = line.strip()
            if item and not item.startswith('#'):
                result.append(item)
    if not result or len(result) != len(set(result)):
        raise ValueError(f'Empty or duplicate IDs in {path}')
    return result


def finalize(selected, results):
    choices = load_decisions(selected)
    to_write = []
    info_rows = []
    for row in selected:
        sp = row['PREFIX']
        fasta, seqs, candidate, rule = results[sp]
        action = choices[sp]
        candidates = {name for name, _, _ in candidate}
        all_names = {name for name, _, _ in seqs}
        if action == 'APPROVE_CANDIDATE':
            if not candidates:
                raise ValueError(f'{sp}: no candidates to approve; choose USE_ID_FILE or SCAFFOLD_ALL')
            selected_ids = candidates
            mode = 'reviewed_' + rule
        elif action == 'USE_ID_FILE':
            selected_ids = set(curated_ids(sp))
            absent = selected_ids - all_names
            if absent:
                raise ValueError(f'{sp}: IDs missing in FASTA: {sorted(absent)[:10]}')
            mode = 'manual_ID_file'
        else:
            selected_ids = all_names
            mode = 'SCAFFOLD_ALL_explicit'
        selected_rows = [(sid, bp) for sid, bp, _ in seqs if sid in selected_ids]
        if not selected_rows:
            raise ValueError(f'{sp}: selected zero sequence IDs')
        all_bp = sum(bp for _, bp, _ in seqs)
        selected_bp = sum(bp for _, bp in selected_rows)
        chrom = PRIMARY_DIR / f'{sp}.chrom.sizes'
        to_write.append((sp, fasta, chrom, selected_rows))
        info_rows.append({'PREFIX': sp, 'ASSEMBLY_OR_SOURCE': row['ASSEMBLY_OR_SOURCE'],
                          'MODE': mode, 'FASTA_SEQS': len(seqs), 'FASTA_BP': all_bp,
                          'SELECTED_SEQS': len(selected_rows), 'SELECTED_BP': selected_bp,
                          'SELECTED_PCT': f'{selected_bp / all_bp * 100:.2f}',
                          'FASTA': str(fasta), 'CHROMSIZE': str(chrom)})

    PRIMARY_DIR.mkdir(parents=True, exist_ok=True)
    for _, _, path, pairs in to_write:
        path.write_text(''.join(f'{sid}\t{bp}\n' for sid, bp in pairs), encoding='utf-8')
    runlist_temp = FINAL_RUNLIST.with_suffix('.tsv.tmp')
    runlist_temp.write_text(''.join(f'{sp}\t{fasta}\t{chrom}\n'
                                    for sp, fasta, chrom, _ in to_write), encoding='utf-8')
    runlist_temp.replace(FINAL_RUNLIST)
    write_tsv(FINAL_INFO, ['PREFIX', 'ASSEMBLY_OR_SOURCE', 'MODE', 'FASTA_SEQS', 'FASTA_BP',
                           'SELECTED_SEQS', 'SELECTED_BP', 'SELECTED_PCT', 'FASTA', 'CHROMSIZE'],
              info_rows)
    print(f'[DONE] Final prediction runlist: {FINAL_RUNLIST} (75 rows, no header)')
    print(f'[DONE] Selected-sequence statistics: {FINAL_INFO}')
    print('[MODE BREAKDOWN]', dict(Counter(x['MODE'] for x in info_rows)))
    print('[CAUTION] SCAFFOLD_ALL cases are full-assembly fallbacks, NOT main-chromosome predictions.')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    stage = parser.add_mutually_exclusive_group(required=True)
    stage.add_argument('--inspect', action='store_true', help='Inspect and create draft candidates and summary')
    stage.add_argument('--finalize', action='store_true', help='After approval, generate final chrom.sizes/runlist')
    args = parser.parse_args()
    selected = load_selection()
    results = inspect_all(selected)
    if args.finalize:
        finalize(selected, results)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as exc:
        print(f'[ERROR] {exc}', file=sys.stderr)
        sys.exit(1)
