#!/usr/bin/env python3
"""Second-pass audit of chromosome IDs in the fixed 75 legume assemblies.

Run on the user's server:
  cd /data/mshe/deepRloopPro_data/rlooppre_75
  python3 audit_primary_sequences_75.py

Reads selected_75_genomes.tsv and chromosome_candidates_75.tsv, and inspects
FAI indices and a *small part* of FASTA files (only deflines as needed).
Reports possible chromosomes, including namespaced IDs such as Gsin.Chr01.
Does NOT modify chromosome_decisions_75.tsv or final prediction inputs.
"""
import argparse
import csv
import re
import sys
from collections import Counter
from pathlib import Path

DEFAULT_WORKDIR = Path('/data/mshe/deepRloopPro_data/rlooppre_75')
EMBEDDED_CHR = re.compile(r'(?:^|[.\-_])chr(?:omosome)?[-_.]?(?:0*[1-9]\d*(?:[a-d])?|[xyzw])$', re.I)
GENERIC_CHR = re.compile(r'\bchromosome\s*(?:[:=_\-]\s*)?(?:\d+[a-d]?|[xyzw]|[ivx]+|[1-9][ls])\b', re.I)
ORGANELLE = re.compile(r'chloroplast|plastid|mitochond|mitogenom|organellar|\bchr[mc]\b|chromosome\s*[:=_ -]?\s*[mc]\b', re.I)
NONPRIMARY = re.compile(r'\bunlocalized\b|\bunplaced\b|\bscaffold\b|\bcontig\b|\bpatch\b|alternate locus|alternate haplotype|\brandom\b', re.I)
ACCESSION = re.compile(r'^(?:CP|OX|OY|OZ)\d+(?:\.\d+)?$', re.I)


def load_tsv(path):
    with path.open(encoding='utf-8', newline='') as f:
        return list(csv.DictReader(f, delimiter='\t'))


def write_tsv(path, keys, rows):
    tmp = path.with_suffix('.tmp')
    with tmp.open('w', encoding='utf-8', newline='') as f:
        w = csv.DictWriter(f, fieldnames=keys, delimiter='\t', lineterminator='\n')
        w.writeheader()
        w.writerows(rows)
    tmp.replace(path)


def read_fai(path):
    fai_path = Path(str(path) + '.fai')
    if not fai_path.is_file():
        raise FileNotFoundError(f'Missing FAI: {fai_path} (run --inspect first)')
    seqs = []
    with fai_path.open(encoding='utf-8') as f:
        for line in f:
            p = line.rstrip('\r\n').split('\t')
            if len(p) < 3:
                raise ValueError(f'Invalid FAI line: {fai_path}')
            seqs.append((p[0], int(p[1]), int(p[2])))
    if not seqs:
        raise ValueError(f'Empty FAI: {fai_path}')
    return seqs


def fasta_header(fasta_handle, offset):
    # In samtools FAI, offset locates the first sequence base. The immediately
    # preceding FASTA line contains the header. Read a short chunk, not sequence.
    n = min(offset, 65536)
    fasta_handle.seek(offset - n)
    payload = fasta_handle.read(n).rstrip(b'\r\n')
    line = payload.rsplit(b'\n', 1)[-1].decode('utf-8', 'replace').lstrip('\r')
    return line[1:] if line.startswith('>') else ''


def status_of(seqid, header):
    if ORGANELLE.search(seqid) or ORGANELLE.search(header):
        return 'ORGANELLE_EXCLUDE'
    if NONPRIMARY.search(seqid) or NONPRIMARY.search(header):
        return 'NONPRIMARY_OR_SCAFFOLD'
    if EMBEDDED_CHR.search(seqid):
        return 'CHR_IN_SEQ_ID_REVIEW'
    if GENERIC_CHR.search(header):
        return 'CHROMOSOME_IN_HEADER_REVIEW'
    if ACCESSION.match(seqid):
        return 'ACCESSION_NEEDS_ASSEMBLY_REPORT'
    return 'UNKNOWN_REVIEW'


def process(workdir, top_n):
    selection = load_tsv(workdir / 'selected_75_genomes.tsv')
    before = load_tsv(workdir / 'chromosome_candidates_75.tsv')
    if len(selection) != 75 or len(before) != 75:
        raise ValueError(f'Expected 75 selected and 75 candidate rows, got {len(selection)} and {len(before)}')
    selected_by_name = {r['PREFIX']: r for r in selection}
    target = []
    for r in before:
        if r['RULE'] == 'NONE' or (r['RULE'] != 'NONE' and float(r['CANDIDATE_PCT']) < 90):
            target.append(r)
    summary = []
    details = []
    named = []
    for k, row in enumerate(target, 1):
        sp = row['PREFIX']
        srow = selected_by_name[sp]
        fasta = Path(srow['SOURCE_DIR']) / srow['FASTA_FILENAME']
        if not fasta.is_file():
            raise FileNotFoundError(fasta)
        seqs = read_fai(fasta)
        ordered = sorted(seqs, key=lambda r: r[1], reverse=True)
        total = sum(x[1] for x in seqs)
        keep = {t[0] for t in ordered[:top_n]}
        # Also inspect namespaced Chr IDs throughout the entire FAI.
        keep.update(x[0] for x in seqs if EMBEDDED_CHR.search(x[0]))
        selected_pairs = []
        with fasta.open('rb') as handle:
            for seqid, length, offset in seqs:
                if seqid not in keep:
                    continue
                header = fasta_header(handle, offset)
                flag = status_of(seqid, header)
                selected_pairs.append((seqid, length, flag))
                details.append({
                    'PREFIX': sp, 'EXISTING_RULE': row['RULE'],
                    'SEQ_ID': seqid, 'LENGTH_BP': length,
                    'LENGTH_MB': f'{length / 1e6:.3f}',
                    'PERCENT_ASSEMBLY': f'{length / total * 100:.3f}',
                    'SECOND_PASS_FLAG': flag,
                    'FASTA_HEADER': header[:300] if header else '(not accessible from .fai offset)',
                })
                if flag == 'CHR_IN_SEQ_ID_REVIEW':
                    named.append({'PREFIX': sp, 'SEQ_ID': seqid, 'LENGTH_BP': length,
                                  'SECOND_PASS_FLAG': flag})
        c = Counter(x[2] for x in selected_pairs)
        top10 = sum(x[1] for x in ordered[:10])
        top20 = sum(x[1] for x in ordered[:20])
        summary.append({
            'PREFIX': sp, 'ASSEMBLY_OR_SOURCE': row['ASSEMBLY_OR_SOURCE'],
            'PREVIOUS_RULE': row['RULE'], 'ASSEMBLY_SEQS': len(seqs),
            'ASSEMBLY_MB': f'{total / 1e6:.2f}',
            'TOP10_PCT': f'{100 * top10 / total:.2f}',
            'TOP20_PCT': f'{100 * top20 / total:.2f}',
            'NAMESPACED_CHR_IDS': c['CHR_IN_SEQ_ID_REVIEW'],
            'HEADER_CHR_IN_AUDITED_SEQS': c['CHROMOSOME_IN_HEADER_REVIEW'],
            'CANDIDATE_ASSEMBLY_FRACTION_PCT': row['CANDIDATE_PCT'],
            'ACTION': 'CHECK_SEQUENCE_REPORT_AND_HEADERS',
        })
        print(f'[{k:02d}/{len(target)}] {sp}: '
              f'{len(seqs)} seqs, namespaced Chr IDs={c["CHR_IN_SEQ_ID_REVIEW"]}, '
              f'top10={100 * top10 / total:.1f}%', flush=True)
    write_tsv(workdir / 'second_round_summary_75.tsv',
              ['PREFIX', 'ASSEMBLY_OR_SOURCE', 'PREVIOUS_RULE', 'ASSEMBLY_SEQS',
               'ASSEMBLY_MB', 'TOP10_PCT', 'TOP20_PCT', 'NAMESPACED_CHR_IDS',
               'HEADER_CHR_IN_AUDITED_SEQS', 'CANDIDATE_ASSEMBLY_FRACTION_PCT', 'ACTION'],
              summary)
    write_tsv(workdir / 'second_round_details_75.tsv',
              ['PREFIX', 'EXISTING_RULE', 'SEQ_ID', 'LENGTH_BP', 'LENGTH_MB',
               'PERCENT_ASSEMBLY', 'SECOND_PASS_FLAG', 'FASTA_HEADER'], details)
    write_tsv(workdir / 'second_round_namespaced_chr_75.tsv',
              ['PREFIX', 'SEQ_ID', 'LENGTH_BP', 'SECOND_PASS_FLAG'], named)
    print(f'[DONE] audited {len(target)} species; wrote three TSV files to {workdir}')
    print('[NOTE] No predictions, decisions, final chromsizes or runlists were modified.')


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--workdir', type=Path, default=DEFAULT_WORKDIR)
    p.add_argument('--top', type=int, default=20, help='Inspect top N longest sequences per reviewed species (default 20)')
    args = p.parse_args()
    if args.top < 1:
        p.error('--top must be >= 1')
