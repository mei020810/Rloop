#!/usr/bin/env python3
"""Full-header chromosome audit for the 33 flagged legume genomes.

Read-only toward source genomes, previous reports, decisions and prediction inputs.
Scans all FAI entries of the 33 flagged genomes, not just top-20 sequences.
Produces full_primary_audit_33.tsv, full_primary_candidate_ids_33.tsv,
and drafts in draft_primary_seqids/ (NOT manual_seqids/).

Usage:
  cd /data/mshe/deepRloopPro_data/rlooppre_75
  python3 audit_all_headers_33.py

Optional:
  python3 audit_all_headers_33.py --workdir /path/to/rlooppre_75

IMPORTANT: inferred chromosome labels are CANDIDATES. Verify counts, IDs,
assembly metadata, organelle exclusion before copying any drafts into
manual_seqids/ and setting USE_ID_FILE in chromosome_decisions_75.tsv.
"""
import argparse
import csv
import re
import sys
from collections import Counter
from pathlib import Path

DEFAULT_DIR = Path('/data/mshe/deepRloopPro_data/rlooppre_75')

# Chromosome names may appear as IDs (Gsin.Chr01), or as header labels
# (chromosome: 1, chromosome 01_Occ, chromosome LG11, Glur_chr1).
SEQ_CHR_RE = re.compile(
    r'(?:^|[._-])chr(?:omosome)?[-_.]?0*[1-9][0-9]{0,2}(?:[ABCDLS])?(?=$|[._-])', re.I)
HEADER_CHROM_RE = re.compile(
    r'\bchromosome\s*[:=_ -]\s*(?:'
    r'0*[1-9][0-9]{0,2}(?:[ABCDLS])?(?:_[A-Za-z0-9]+)?'
    r'|LG[-_ ]?0*[1-9][0-9]{0,2}'
    r'|[IVX]{1,4}|[XYZW])(?=$|[\s,;.\t])', re.I)
HEADER_ALIAS_RE = re.compile(
    r'(?:^|[._-])chr0*[1-9][0-9]{0,2}(?:[ABCDLS])?(?=$|[.,;\s_\-])', re.I)
ORGANELLE_RE = re.compile(
    r'chloroplast|plastid|mitochondri|mitogenom|organelle|\bchr[CM]\b|'
    r'chromosome\s*[:=_ -]\s*[CM](?=$|[\s,;.\t])', re.I)
NONPRIMARY_RE = re.compile(
    r'unlocalized|unplaced|alternate[ _-](?:haplotype|locus)|'
    r'\bscaffold\b|scaffold[_ -]|\bcontig\b|contig[_ -]|'
    r'\bpatch\b|\brandom\b', re.I)

SUMMARY_COLS = [
    'PREFIX', 'PREVIOUS_RULE', 'FASTA_SEQS', 'ASSEMBLY_MB',
    'PREVIOUS_CANDIDATE_PCT', 'HEADER_CHROM_SEQS', 'SEQID_CHR_SEQS',
    'HEADER_ALIAS_CHR_SEQS', 'PRIMARY_CANDIDATE_SEQS',
    'PRIMARY_CANDIDATE_BP', 'PRIMARY_CANDIDATE_PCT',
    'ORGANELLE_SEQS', 'NONPRIMARY_SEQS', 'HEADER_UNREADABLE_SEQS',
    'STATUS', 'NEXT_ACTION', 'NOTES',
]
DETAIL_COLS = ['PREFIX', 'SEQ_ID', 'LENGTH_BP', 'EVIDENCE', 'FASTA_HEADER']


def read_tsv(path):
    with path.open('r', encoding='utf-8', newline='') as handle:
        return list(csv.DictReader(handle, delimiter='\t'))


def write_tsv(path, fields, records):
    tmp = path.with_name(path.name + '.tmp')
    with tmp.open('w', encoding='utf-8', newline='') as handle:
        w = csv.DictWriter(handle, fieldnames=fields, delimiter='\t',
                           lineterminator='\n', extrasaction='ignore')
        w.writeheader()
        w.writerows(records)
    tmp.replace(path)


def fasta_header(handle, offset):
    """Use samtools fai sequence offsets to read the preceding FASTA title.

    Start with a short block; retry for unusually long FASTA descriptions.
    Input FASTA should be uncompressed, as in the user's 75-genome manifest.
    """
    for limit in (2048, 65536):
        n = min(limit, offset)
        handle.seek(offset - n)
        payload = handle.read(n).rstrip(b'\r\n')
        last_line = payload.rsplit(b'\n', 1)[-1].lstrip(b'\r')
        if last_line.startswith(b'>'):
            return last_line[1:].decode('utf-8', 'replace')
    return ''


def classify(seqid, header):
    combined = seqid + ' ' + header
    if ORGANELLE_RE.search(combined):
        return 'ORGANELLE'
    if NONPRIMARY_RE.search(combined):
        return 'NONPRIMARY_OR_SCAFFOLD'
    if SEQ_CHR_RE.search(seqid):
        return 'SEQID_CHR'
    if HEADER_CHROM_RE.search(header):
        return 'HEADER_CHROM'
    if HEADER_ALIAS_RE.search(header):
        return 'HEADER_ALIAS_CHR'
    return 'UNRESOLVED'


def scan_one(species, fasta, info):
    fai = Path(str(fasta) + '.fai')
    if not fasta.is_file() or not fai.is_file() or fasta.stat().st_size == 0:
        raise FileNotFoundError(f'FASTA/FAI missing: {fasta} / {fai}')
    if fai.stat().st_mtime < fasta.stat().st_mtime:
        raise ValueError(f'FAI older than FASTA, rerun samtools faidx: {fasta}')
    stats = Counter()
    accepted = []
    detail_rows = []
    total_bp = 0
    with fasta.open('rb') as fh, fai.open('r', encoding='utf-8') as fx:
        for i, raw in enumerate(fx, 1):
            fields = raw.rstrip('\r\n').split('\t')
            if len(fields) < 3:
                raise ValueError(f'Invalid FAI {fai}:{i}')
            seqid, bp, offset = fields[0], int(fields[1]), int(fields[2])
            if bp <= 0 or offset < 0:
                raise ValueError(f'Invalid length/offset in {fai}:{i}')
            total_bp += bp
            title = fasta_header(fh, offset)
            flag = classify(seqid, title)
            stats[flag] += 1
            stats['ALL'] += 1
            if not title:
                stats['UNREADABLE_HEADER'] += 1
            if flag in {'SEQID_CHR', 'HEADER_CHROM', 'HEADER_ALIAS_CHR'}:
                accepted.append((seqid, bp))
                detail_rows.append({
                    'PREFIX': species, 'SEQ_ID': seqid,
                    'LENGTH_BP': bp, 'EVIDENCE': flag,
                    'FASTA_HEADER': title[:400]
                })

    expected = int(info['ASSEMBLY_SEQS'])
    if stats['ALL'] != expected:
        raise ValueError(f'{species}: FAI count changed from second round: '
                         f"{stats['ALL']} != {expected}")
    if len(accepted) != len(set(s for s, _ in accepted)):
        raise ValueError(f'{species}: duplicate selected seqIDs')
    chosen_bp = sum(bp for _, bp in accepted)
    frac = 100.0 * chosen_bp / total_bp
    if accepted:
        status = 'EXPLICIT_CHROMOSOME_CANDIDATES'
        action = 'VERIFY_COMPLETE_IDS_AND_ASSEMBLY_THEN_USE_ID_FILE'
    else:
        status = 'NO_EXPLICIT_CHROMOSOME_LABEL'
        action = 'VERIFY_ASSEMBLY_LEVEL_AND_DECIDE_NUCLEAR_SCAFFOLD_FALLBACK'
    if stats['UNREADABLE_HEADER']:
        action = 'FIX_UNREADABLE_HEADERS_BEFORE_DECIDING'
    # Highlight a discrepancy between the new complete scan and prior CM/NC candidates.
    notes = []
    old_pct = float(info['CANDIDATE_ASSEMBLY_FRACTION_PCT'])
    if info['PREVIOUS_RULE'] != 'NONE' and abs(frac - old_pct) > 1.0:
        notes.append('DIFFERS_FROM_PREVIOUS_CANDIDATE_PCT')
    if frac < 60 and accepted:
        notes.append('LOW_SELECTED_FRACTION')
    if species in ('Ononis_reclinata', 'Laburnum_anagyroides'):
        notes.append('FULL_SCAN_CRITICAL_TOP20_AUDIT_WAS_TRUNCATED')
    report = {
        'PREFIX': species,
        'PREVIOUS_RULE': info['PREVIOUS_RULE'],
        'FASTA_SEQS': stats['ALL'],
        'ASSEMBLY_MB': f'{total_bp/1e6:.3f}',
        'PREVIOUS_CANDIDATE_PCT': info['CANDIDATE_ASSEMBLY_FRACTION_PCT'],
        'HEADER_CHROM_SEQS': stats['HEADER_CHROM'],
        'SEQID_CHR_SEQS': stats['SEQID_CHR'],
        'HEADER_ALIAS_CHR_SEQS': stats['HEADER_ALIAS_CHR'],
        'PRIMARY_CANDIDATE_SEQS': len(accepted),
        'PRIMARY_CANDIDATE_BP': chosen_bp,
        'PRIMARY_CANDIDATE_PCT': f'{frac:.2f}',
        'ORGANELLE_SEQS': stats['ORGANELLE'],
        'NONPRIMARY_SEQS': stats['NONPRIMARY_OR_SCAFFOLD'],
        'HEADER_UNREADABLE_SEQS': stats['UNREADABLE_HEADER'],
        'STATUS': status, 'NEXT_ACTION': action,
        'NOTES': ';'.join(notes),
    }
    return report, detail_rows, accepted


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--workdir', type=Path, default=DEFAULT_DIR)
    args = p.parse_args()
    work = args.workdir
    selection = read_tsv(work / 'selected_75_genomes.tsv')
    audit = read_tsv(work / 'second_round_summary_75.tsv')
    if len(selection) != 75 or len(audit) != 33:
        raise ValueError(f'Expected 75 selected and 33 second-round rows; '
                         f'got {len(selection)} and {len(audit)}')
    by_species = {r['PREFIX']: r for r in selection}
    if len(by_species) != 75 or len({r['PREFIX'] for r in audit}) != 33:
        raise ValueError('Duplicate species in input files')
    reports, details = [], []
    draft_dir = work / 'draft_primary_seqids'
    draft_dir.mkdir(parents=True, exist_ok=True)
    for i, r in enumerate(audit, 1):
        sp = r['PREFIX']
        if sp not in by_species:
            raise ValueError(f'Species not in selection: {sp}')
        src = by_species[sp]
        fasta = Path(src['SOURCE_DIR']) / src['FASTA_FILENAME']
        report, detail, accepted = scan_one(sp, fasta, r)
        reports.append(report)
        details.extend(detail)
        draft_path = draft_dir / f'{sp}.txt'
        if accepted:
            draft_path.write_text(''.join(f'{seq}\n' for seq, _ in accepted),
                                  encoding='utf-8')
        elif draft_path.exists():
            draft_path.unlink()
        print(f'[{i:02d}/33] {sp}: '
              f"{report['PRIMARY_CANDIDATE_SEQS']} explicit chromosome labels, "
              f"{report['PRIMARY_CANDIDATE_PCT']}%", flush=True)
    write_tsv(work / 'full_primary_audit_33.tsv', SUMMARY_COLS, reports)
    write_tsv(work / 'full_primary_candidate_ids_33.tsv', DETAIL_COLS, details)
    print(f'[DONE] {len(reports)} species examined, '
          f'{sum(r["PRIMARY_CANDIDATE_SEQS"] for r in reports)} candidate sequences')
    print('[CAUTION] Draft ID files are not final or approved; compare with assembly metadata.')
    print(f'[OUTPUT] {work / "full_primary_audit_33.tsv"}')
    print(f'[OUTPUT] {work / "full_primary_candidate_ids_33.tsv"}')
    print(f'[OUTPUT] {draft_dir}')
    print('[SAFE] Existing chromosome_decisions_75.tsv, manual_seqids, final '
          'chromsizes and deepRloop run lists were NOT changed.')


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError) as exc:
        print('[ERROR]', exc, file=sys.stderr)
        sys.exit(1)

