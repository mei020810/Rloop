                bad=1
            }
        }
        if (bad) exit 1
    }' "$ids" "$fai" > "$chrom"

    # 统计长度和数量
    local n bp total pct

    n=$(wc -l < "$chrom")

    bp=$(awk '{s+=$2} END {printf "%.0f",s}' "$chrom")

    total=$(awk '{s+=$2} END {printf "%.0f",s}' "$fai")

