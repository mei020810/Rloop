summarize() {
    local sp="$1"
    local prefix="$2"
    local chrom="$3"
    local fwd="$4"
    local rev="$5"
    local source="$6"

    for file in "$chrom" "$fwd" "$rev"; do
        [[ -s "$file" ]] || {
            echo "[ERROR] Missing file: $file" >&2
            return 1
        }
    done

    # 检查BED坐标是否在选定染色体范围内
    awk '
    NR==FNR {
        size[$1]=$2
        next
    }
    NF<6 || !($1 in size) ||
    $2<0 || $3<=$2 || $3>size[$1] ||
    ($6!="+" && $6!="-") {
        bad++
        if (bad<=3)
            print "[BAD_COORD]",FILENAME,FNR,$0 > "/dev/stderr"
    }
    END {
        if (bad) exit 1
    }
    ' "$chrom" "$fwd" "$rev"

    # 正反向数量和长度
    read -r wn wb < <(
        awk '{n++; bp+=$3-$2}
        END {printf "%d %.0f\n",n,bp}' "$fwd"
    )

    read -r cn cb < <(
        awk '{n++; bp+=$3-$2}
        END {printf "%d %.0f\n",n,bp}' "$rev"
    )

    # 预测范围总长度
    genome=$(awk '{s+=$2}
        END {printf "%.0f",s}' "$chrom")

    # 合并正反向区间，计算不重复覆盖长度
    covered=$(
        awk 'BEGIN{OFS="\t"} {print $1,$2,$3}' "$fwd" "$rev" |
        LC_ALL=C sort -k1,1 -k2,2n -k3,3n |
        awk '
        NR==1 {
            chr=$1; start=$2; end=$3
            next
        }
        $1==chr && $2<=end {
            if ($3>end) end=$3
            next
        }
        {
            sum+=end-start
            chr=$1; start=$2; end=$3
        }
        END {
            if (NR>0) sum+=end-start
            printf "%.0f\n",sum
        }'
    )

    # 输出统计结果
    awk -v sp="$sp" -v prefix="$prefix" \
        -v genome="$genome" -v wn="$wn" -v wb="$wb" \
        -v cn="$cn" -v cb="$cb" -v covered="$covered" \
        -v source="$source" '
    BEGIN {
        n=wn+cn
        mean=(n>0 ? (wb+cb)/n : 0)
        density=n/genome*100000000
        coverage=covered/genome*100

        printf "%s\t%s\t%.0f\t%d\t%d\t%d\t%.2f\t%.2f\t%.0f\t%.4f\t%s\n",
        sp,prefix,genome,wn,cn,n,mean,density,covered,coverage,source
    }'

    echo "[OK] $sp" >&2
}

