import csv

input_csv = "genus_79_meta.csv"
output_nwk = "legume_79genera_taxonomy.nwk"

levels = ["Subfamily", "Major_clade", "Clade_2", "Genus"]

def clean(x):
    if x is None:
        return ""
    x = str(x).strip()
    if x.lower() in ["nan", "none"]:
        return ""
    x = x.replace(" ", "_")
    x = x.replace("/", "_")
    x = x.replace("+", "_plus_")
    x = x.replace("(", "").replace(")", "")
    x = x.replace(",", "")
    return x

tree = {}

def add_path(root, path):
    node = root
    for item in path:
        if item == "":
            continue
        node = node.setdefault(item, {})

with open(input_csv, newline="", encoding="utf-8-sig") as f:
    reader = csv.DictReader(f)
    for row in reader:
        path = ["Fabaceae"] + [clean(row.get(col, "")) for col in levels]
        add_path(tree, path)

def to_newick(node, name=""):
    if not node:
        return name
    children = [to_newick(child_node, child_name) for child_name, child_node in node.items()]
    if name:
        return "(" + ",".join(children) + ")" + name
    return "(" + ",".join(children) + ")"

nwk = to_newick(tree) + ";"

with open(output_nwk, "w", encoding="utf-8") as f:
    f.write(nwk)

print(f"Saved: {output_nwk}")
python make_taxonomy_tree.py


