}

get_rloop_total_and_mean() {
    local bed="$1"

    awk '
    {
        len = $3 - $2
        if (len > 0) {
            sum += len
            n++
        }
    }
    END {
        if (n > 0) {
            printf "%d %.2f\n", sum, sum/n
        } else {
            print "0 0"
        }
    }
    ' "$bed"
}

get_rloop_merged_total() {
    local bed="$1"

    if command -v bedtools >/dev/null 2>&1; then
        bedtools sort -i "$bed" \
        | bedtools merge -i - \
        | awk '{sum += $3 - $2} END{print sum+0}'
    else
        sort -k1,1 -k2,2n "$bed" \
        | awk '
        BEGIN {
            chr = ""
            start = -1
            end = -1
            sum = 0
        }
        {
            c = $1
            s = $2
            e = $3

            if (chr == "") {
                chr = c
                start = s
                end = e
                next
            }

            if (c == chr && s <= end) {
                if (e > end) end = e
            } else {
                sum += end - start
                chr = c
                start = s
                end = e
            }
        }
        END {
            if (chr != "") sum += end - start
            print sum+0
        }
        '
    fi
}

for bed in $(ls "${BED_DIR}"/*_final_predict.bed 2>/dev/null | sort)
do
    [[ -e "$bed" ]] || continue

    prefix=$(basename "$bed" _final_predict.bed)

    fasta="${FASTAMAP[$prefix]:-NA}"
    chromsize="${CHRMAP[$prefix]:-NA}"
    fai="${FAIMAP[$prefix]:-NA}"
    anno="${ANNOMAP[$prefix]:-NA}"

    subfamily="${SUBFAMILY[$prefix]:-NA}"
    major_branch="${BRANCH[$prefix]:-NA}"

    if [[ "$chromsize" == "NA" || ! -f "$chromsize" ]]; then
        echo "[WARN] $prefix 的 chromsize 不存在: $chromsize" >&2
    fi

    if [[ "$fai" == "NA" || ! -f "$fai" ]]; then
        echo "[WARN] $prefix 的 fai 不存在: $fai" >&2
    fi

    if [[ "$anno" == "NA" || ! -f "$anno" ]]; then
        echo "[WARN] $prefix 的 annotation 不存在: $anno" >&2
    fi

    # 如果 annotation_list 和 new_list_A 里的 chromsize 不一致，给警告
    anno_chrom="${ANNO_CHRMAP[$prefix]:-NA}"
    if [[ "$anno_chrom" != "NA" && "$chromsize" != "NA" && "$anno_chrom" != "$chromsize" ]]; then
        echo "[WARN] $prefix chromsize 不一致:" >&2
        echo "       new_list_A:        $chromsize" >&2
        echo "       annotation_list:   $anno_chrom" >&2
    fi

    # assembly size 直接由 fai 计算
    if [[ "$fai" != "NA" && -f "$fai" ]]; then
        assembly_size=$(get_assembly_size_from_fai "$fai")
    else
        assembly_size="NA"
    fi

    # 主染色体数量和长度
    if [[ "$chromsize" != "NA" && -f "$chromsize" ]]; then
        main_chr_n=$(wc -l < "$chromsize")
        main_chr_size=$(awk '{sum += $2} END{print sum+0}' "$chromsize")
    else
        main_chr_n="NA"
        main_chr_size="NA"
    fi

    # gene number
     if [[ "$anno" != "NA" && -f "$anno" && "$chromsize" != "NA" && -f "$chromsize" ]]; then
         read -r gene_number gene_number_source < <(get_gene_number_and_source_main_chr "$anno" "$chromsize")
     else
          gene_number="NA"
          gene_number_source="NA"
     fi

    # gene density
    if [[ "$gene_number" != "NA" && "$main_chr_size" != "NA" && "$main_chr_size" -gt 0 ]]; then
        gene_density=$(awk -v g="$gene_number" -v s="$main_chr_size" 'BEGIN{printf "%.4f", g/(s/1000000)}')
    else
        gene_density="NA"
    fi

    # GC content，可选
    if [[ "$fasta" != "NA" && -f "$fasta" && "$chromsize" != "NA" && -f "$chromsize" ]]; then
        gc_content=$(get_main_chr_gc "$fasta" "$chromsize")
    else
        gc_content="NA"
    fi

    # R-loop 区域数
    rloop_n=$(wc -l < "$bed")

    # R-loop 原始总长度和平均长度
    read -r rloop_total_bp rloop_mean_len < <(get_rloop_total_and_mean "$bed")

    # R-loop merge 后非冗余覆盖长度
    rloop_merged_total_bp=$(get_rloop_merged_total "$bed")

    # R-loop density / coverage
    if [[ "$main_chr_size" != "NA" && "$main_chr_n" != "NA" && "$main_chr_size" -gt 0 && "$main_chr_n" -gt 0 ]]; then
        rloop_density=$(awk -v r="$rloop_n" -v l="$main_chr_size" 'BEGIN{printf "%.2f", r/l*100000000}')
        rloop_coverage=$(awk -v t="$rloop_total_bp" -v l="$main_chr_size" 'BEGIN{printf "%.6f", t/l}')
        rloop_merged_coverage=$(awk -v t="$rloop_merged_total_bp" -v l="$main_chr_size" 'BEGIN{printf "%.6f", t/l}')
        rloop_per_chr_mean=$(awk -v r="$rloop_n" -v n="$main_chr_n" 'BEGIN{printf "%.2f", r/n}')

        rloop_per_chr_counts=$(awk '
        NR == FNR {
            chr[$1] = 0
            order[++n] = $1
            next
        }
        {
            chr[$1]++
        }
        END {
            for (i = 1; i <= n; i++) {
                c = order[i]
                printf "%s:%d", c, chr[c]
                if (i < n) printf ";"
            }
            printf "\n"
        }
        ' "$chromsize" "$bed")
    else
        rloop_density="NA"
        rloop_coverage="NA"
        rloop_merged_coverage="NA"
        rloop_per_chr_mean="NA"
        rloop_per_chr_counts=$(awk '{print $1}' "$bed" | sort | uniq -c | awk '{print $2 ":" $1}' | paste -sd ';' -)
    fi

printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" \
