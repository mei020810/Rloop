#!/usr/bin/env python3
import sys
import gzip
import hashlib

def open_maybe_gz(path):
    if path.endswith(".gz"):
        return gzip.open(path, "rt")
    return open(path, "r")

def read_fasta(path):
    seqs = {}
    name = None
    chunks = []
    with open_maybe_gz(path) as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            if line.startswith(">"):
                if name is not None:
                    seqs[name] = "".join(chunks).upper()
                name = line[1:].split()[0]
                chunks = []
            else:
                chunks.append(line)
        if name is not None:
            seqs[name] = "".join(chunks).upper()
    return seqs

def md5seq(seq):
    return hashlib.md5(seq.encode()).hexdigest()

def revcomp(seq):
    table = str.maketrans("ACGTNacgtn", "TGCANtgcan")
    return seq.translate(table)[::-1].upper()

if len(sys.argv) != 4:
    sys.exit("Usage: python check_fasta_identity.py article.fa ncbi.fa zenia_chr.map")

article_fa, ncbi_fa, map_file = sys.argv[1:4]

article = read_fasta(article_fa)
ncbi = read_fasta(ncbi_fa)

all_ok = True

with open(map_file) as f:
    for line in f:
        if not line.strip() or line.startswith("#"):
            continue
        a_id, n_id = line.strip().split()[:2]

        if a_id not in article:
            print(f"MISSING in article fasta: {a_id}")
            all_ok = False
            continue
        if n_id not in ncbi:
            print(f"MISSING in NCBI fasta: {n_id}")
            all_ok = False
            continue

        a_seq = article[a_id]
        n_seq = ncbi[n_id]

        a_md5 = md5seq(a_seq)
        n_md5 = md5seq(n_seq)

        if len(a_seq) == len(n_seq) and a_md5 == n_md5:
            print(f"OK\t{a_id}\t{n_id}\tlen={len(a_seq)}\tmd5={a_md5}")
        elif len(a_seq) == len(n_seq) and md5seq(revcomp(a_seq)) == n_md5:
            print(f"REVERSE_COMPLEMENT\t{a_id}\t{n_id}\tlen={len(a_seq)}")
            all_ok = False
        else:
            print(f"DIFFERENT\t{a_id}\t{n_id}\tarticle_len={len(a_seq)}\tncbi_len={len(n_seq)}\tarticle_md5={a_md5}\tncbi_md5={n_md5}")
            all_ok = False

if all_ok:
    print("RESULT: all mapped chromosomes are identical.")
else:
    print("RESULT: some mapped chromosomes are not identical.")

