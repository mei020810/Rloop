            return id
        }

        $0 ~ /^#/ { next }
        !($1 in keep) { next }

        $3 == "gene" {
            gene_n++
            next
        }

        $3 == "mRNA" {
            fallback = $1 ":" $4 "-" $5 ":" $7
            gid = get_proxy_gene_id($9, fallback)
