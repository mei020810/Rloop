get_assembly_size_from_fai() {
    local fai="$1"

    if [[ ! -f "$fai" ]]; then
        echo "NA"
        return
    fi

    awk '{sum += $2} END{print sum+0}' "$fai"
}

get_main_chr_gc() {
    local fasta="$1"
    local chromsize="$2"

    if [[ "$CALC_GC" != "1" ]]; then
        echo "NA"
        return
    fi

    if [[ ! -f "$fasta" || ! -f "$chromsize" ]]; then
        echo "NA"
        return
    fi

    awk '
    NR == FNR {
        keep[$1] = 1
        next
    }

    /^>/ {
        name = substr($0, 2)
        split(name, header_field, /[ \t]/)
        chr = header_field[1]
        use = (chr in keep)
        next
    }

    use {
        seq = toupper($0)

        g_count += gsub(/G/, "G", seq)
        c_count += gsub(/C/, "C", seq)
        a_count += gsub(/A/, "A", seq)
        t_count += gsub(/T/, "T", seq)
    }

    END {
        total = a_count + t_count + g_count + c_count
        if (total > 0) {
            printf "%.6f", (g_count + c_count) / total
        } else {
            print "NA"
        }
    }
    ' "$chromsize" "$fasta"
}

get_gene_number_and_source_main_chr() {
