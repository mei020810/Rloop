                keep[a[1]] = 1
            }
            close(chromsize)
        }

        function get_proxy_gene_id(attr, fallback, id, a, b) {
            id = ""

            if (match(attr, /Parent=([^;]+)/, a)) {
                id = a[1]
            } else if (match(attr, /gene_id "([^"]+)"/, a)) {
                id = a[1]
            } else if (match(attr, /ID=([^;]+)/, a)) {
                id = a[1]
            } else if (match(attr, /transcript_id "([^"]+)"/, a)) {
                id = a[1]
            } else {
                id = fallback
            }

            split(id, b, ",")
            id = b[1]

            gsub(/^gene:/, "", id)
            sub(/-t[0-9]+(_[^;]+)?$/, "", id)
            sub(/\.t[0-9]+$/, "", id)
            sub(/_mRNA[0-9]+$/, "", id)

            return id
        }

        $0 ~ /^#/ { next }
        !($1 in keep) { next }

        $3 == "gene" {
            gene_n++
            next
        }

        $3 == "mRNA" {
            fallback = $1 ":" $4 "-" $5 ":" $7
            gid = get_proxy_gene_id($9, fallback)
            mrna_gene[gid] = 1
            next
        }

        $3 == "transcript" {
            fallback = $1 ":" $4 "-" $5 ":" $7
            gid = get_proxy_gene_id($9, fallback)
            transcript_gene[gid] = 1
            next
        }

        END {
            if (gene_n > 0) {
                print gene_n, "gene"
            } else {
                for (g in mrna_gene) mrna_n++
                for (g in transcript_gene) transcript_n++

                if (mrna_n > 0) {
                    print mrna_n, "mRNA_proxy"
                } else if (transcript_n > 0) {
                    print transcript_n, "transcript_proxy"
                } else {
                    print 0, "unavailable"
                }
            }
        }
        '
    else
        awk '
        BEGIN {
            OFS = "\t"
        }

        NR == FNR {
            keep[$1] = 1
            next
        }

        function get_proxy_gene_id(attr, fallback, id, a, b) {
            id = ""

            if (match(attr, /Parent=([^;]+)/, a)) {
                id = a[1]
            } else if (match(attr, /gene_id "([^"]+)"/, a)) {
