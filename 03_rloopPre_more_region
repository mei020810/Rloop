#!/usr/bin/env bash
set -euo pipefail
# 用法:
# bash build_annotation_beds_with_tts.sh \
#   <annotation.gtf/gff/gff3> \
#   <chromsize> \
#   <outdir> \
#   [promoter_bp] \
#   [tts_bp]

if [[ $# -lt 3 ]]; then
  echo "Usage: bash $0 <annotation.gtf/gff/gff3> <chromsize> <outdir> [promoter_bp] [tts_bp]" >&2
  exit 1
fi

ANNO="$1"
CHROMSIZE="$2"
OUTDIR="$3"
PROMOTER_BP="${4:-2000}"
TTS_BP="${5:-2000}"
mkdir -p "$OUTDIR"

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "[ERROR] missing command: $1" >&2
    exit 1
  }
}

need_cmd awk
need_cmd bedtools

if [[ ! -f "$ANNO" ]]; then
  echo "[ERROR] annotation file not found: $ANNO" >&2
  exit 1
fi

if [[ ! -f "$CHROMSIZE" ]]; then
  echo "[ERROR] chromsize not found: $CHROMSIZE" >&2
  exit 1
fi

echo "[INFO] annotation  = $ANNO"
echo "[INFO] chromsize   = $CHROMSIZE"
echo "[INFO] outdir      = $OUTDIR"
echo "[INFO] promoter_bp = $PROMOTER_BP"
echo "[INFO] tts_bp      = $TTS_BP"

# ----------------------------
# 1. gene body
# GTF/GFF: 1-based inclusive
# BED: 0-based half-open
# ----------------------------
awk 'BEGIN{FS=OFS="\t"}
FNR==NR {
  keep[$1] = 1
  next
}
$0 !~ /^#/ && $3 == "gene" && ($1 in keep) {
  start = $4 - 1
  if (start < 0) start = 0
  print $1, start, $5, $9, ".", $7
}' "$CHROMSIZE" "$ANNO" \
  | bedtools sort -g "$CHROMSIZE" -i - \
  > "$OUTDIR/gene_body.bed"

gene_n=$(wc -l < "$OUTDIR/gene_body.bed")
if [[ "$gene_n" -eq 0 ]]; then
  echo "[ERROR] no gene features found after filtering by chromsize." >&2
  echo "[HINT] Check whether annotation seqids match chromsize seqids." >&2
  exit 1
fi

echo "[INFO] gene features retained: $gene_n"

cut -f1-3 "$OUTDIR/gene_body.bed" \
  | bedtools sort -g "$CHROMSIZE" -i - \
  | bedtools merge -i - \
  > "$OUTDIR/gene_body.merged.bed"

# ----------------------------
# 2. promoter
# + strand: upstream of TSS
# - strand: upstream in transcription sense
# ----------------------------
awk -v UP="$PROMOTER_BP" 'BEGIN{FS=OFS="\t"}
FNR==NR {
  chrlen[$1] = $2
  next
}
$0 !~ /^#/ && $3 == "gene" {
  if (!($1 in chrlen)) next

  if ($7 == "+") {
    s = $4 - UP - 1
    if (s < 0) s = 0
    e = $4 - 1
    if (e > s) print $1, s, e, $9, ".", $7
  }
  else if ($7 == "-") {
    s = $5
    e = $5 + UP
    if (e > chrlen[$1]) e = chrlen[$1]
    if (e > s) print $1, s, e, $9, ".", $7
  }
}' "$CHROMSIZE" "$ANNO" \
  | bedtools sort -g "$CHROMSIZE" -i - \
  > "$OUTDIR/promoter_${PROMOTER_BP}bp.bed"

cut -f1-3 "$OUTDIR/promoter_${PROMOTER_BP}bp.bed" \
  | bedtools sort -g "$CHROMSIZE" -i - \
  | bedtools merge -i - \
  > "$OUTDIR/promoter_${PROMOTER_BP}bp.merged.bed"

# ----------------------------
# 3. TTS / downstream region
# + strand: downstream of gene end
# - strand: downstream in transcription sense = lower coordinate side
# ----------------------------
awk -v DOWN="$TTS_BP" 'BEGIN{FS=OFS="\t"}
FNR==NR {
  chrlen[$1] = $2
  next
}
$0 !~ /^#/ && $3 == "gene" {
  if (!($1 in chrlen)) next

  if ($7 == "+") {
    s = $5
    e = $5 + DOWN
    if (e > chrlen[$1]) e = chrlen[$1]
    if (e > s) print $1, s, e, $9, ".", $7
  }
  else if ($7 == "-") {
    s = $4 - DOWN - 1
    if (s < 0) s = 0
    e = $4 - 1
    if (e > s) print $1, s, e, $9, ".", $7
  }
}' "$CHROMSIZE" "$ANNO" \
  | bedtools sort -g "$CHROMSIZE" -i - \
  > "$OUTDIR/tts_${TTS_BP}bp.bed"

cut -f1-3 "$OUTDIR/tts_${TTS_BP}bp.bed" \
  | bedtools sort -g "$CHROMSIZE" -i - \
  | bedtools merge -i - \
  > "$OUTDIR/tts_${TTS_BP}bp.merged.bed"

# ----------------------------
# 4. gene_associated = promoter + gene body + TTS
# ----------------------------
cat \
  "$OUTDIR/promoter_${PROMOTER_BP}bp.merged.bed" \
  "$OUTDIR/gene_body.merged.bed" \
  "$OUTDIR/tts_${TTS_BP}bp.merged.bed" \
  | bedtools sort -g "$CHROMSIZE" -i - \
  | bedtools merge -i - \
  > "$OUTDIR/gene_associated.merged.bed"

# non_gene_associated = genome - gene_associated
bedtools complement \
  -i "$OUTDIR/gene_associated.merged.bed" \
  -g "$CHROMSIZE" \
  > "$OUTDIR/non_gene_associated.bed"

# ----------------------------
# 5. total bp summary
# ----------------------------
awk 'BEGIN{s=0} {s+=($3-$2)} END{print s+0}' "$OUTDIR/gene_body.merged.bed" \
  > "$OUTDIR/gene_body.total_bp.txt"

awk 'BEGIN{s=0} {s+=($3-$2)} END{print s+0}' "$OUTDIR/promoter_${PROMOTER_BP}bp.merged.bed" \
  > "$OUTDIR/promoter_${PROMOTER_BP}bp.total_bp.txt"

awk 'BEGIN{s=0} {s+=($3-$2)} END{print s+0}' "$OUTDIR/tts_${TTS_BP}bp.merged.bed" \
  > "$OUTDIR/tts_${TTS_BP}bp.total_bp.txt"

awk 'BEGIN{s=0} {s+=($3-$2)} END{print s+0}' "$OUTDIR/gene_associated.merged.bed" \
  > "$OUTDIR/gene_associated.total_bp.txt"

awk 'BEGIN{s=0} {s+=($3-$2)} END{print s+0}' "$OUTDIR/non_gene_associated.bed" \
  > "$OUTDIR/non_gene_associated.total_bp.txt"

echo "[OK] BED files created:"
echo "  $OUTDIR/gene_body.bed"
echo "  $OUTDIR/promoter_${PROMOTER_BP}bp.bed"
echo "  $OUTDIR/tts_${TTS_BP}bp.bed"
echo "  $OUTDIR/gene_body.merged.bed"
echo "  $OUTDIR/promoter_${PROMOTER_BP}bp.merged.bed"
echo "  $OUTDIR/tts_${TTS_BP}bp.merged.bed"
echo "  $OUTDIR/gene_associated.merged.bed"
echo "  $OUTDIR/non_gene_associated.bed"

chmod +x build_annotation_beds_with_tts.sh
